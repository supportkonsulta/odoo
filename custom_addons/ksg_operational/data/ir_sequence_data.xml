<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_operational_manpower_request" model="ir.sequence">
            <field name="name">Nomor Permintaan SDM</field>
            <field name="code">ksg.operational.manpower</field>
            <field name="prefix">SDM/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_operational_supply_request" model="ir.sequence">
            <field name="name">Nomor Permintaan Perlengkapan</field>
            <field name="code">ksg.operational.supply</field>
            <field name="prefix">SUP/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_operational_hpp" model="ir.sequence">
            <field name="name">Nomor Lembar HPP</field>
            <field name="code">ksg.operational.hpp</field>
            <field name="prefix">HPP/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_operational_assignment" model="ir.sequence">
            <field name="name">ID Penugasan Pekerja</field>
            <field name="code">ksg.operational.assignment</field>
            <field name="prefix">ASN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_operational_attendance" model="ir.sequence">
            <field name="name">Nomor Laporan Presensi</field>
            <field name="code">ksg.operational.attendance</field>
            <field name="prefix">PRS/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_operational_bast" model="ir.sequence">
            <field name="name">Nomor BAST Operasional</field>
            <field name="code">ksg.operational.bast</field>
            <field name="prefix">BAST/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_operational_work_report" model="ir.sequence">
            <field name="name">Nomor Laporan Pekerjaan</field>
            <field name="code">ksg.operational.work.report</field>
            <field name="prefix">LPK/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
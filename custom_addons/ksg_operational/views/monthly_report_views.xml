<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_operational_monthly_report_form" model="ir.ui.view">
        <field name="name">ksg.operational.monthly.report.form</field>
        <field name="model">ksg.operational.monthly.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Bulanan Proyek">
                <header>
                    <button name="action_submit" type="object" string="Serahkan ke Manajemen" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Setujui" class="btn-success" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Laporan Bulanan"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Informasi Proyek">
                            <field name="project_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="periode_bulan" readonly="state != 'draft'"/>
                            <field name="tahun" readonly="state != 'draft'"/>
                        </group>
                        <group string="Progres &amp; SDM">
                            <field name="progres_fisik" widget="percentage" readonly="state != 'draft'"/>
                            <field name="pekerja_aktif_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kendala &amp; Solusi" name="kendala_page">
                            <group>
                                <field name="kendala" placeholder="Kendala selama operasional bulan berjalan..."/>
                                <field name="solusi" placeholder="Tindakan koreksi atau mitigasi..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_operational_monthly_report_list" model="ir.ui.view">
        <field name="name">ksg.operational.monthly.report.list</field>
        <field name="model">ksg.operational.monthly.report</field>
        <field name="arch" type="xml">
            <list string="Laporan Bulanan Proyek" decoration-success="state == 'approved'" decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="periode_bulan"/>
                <field name="tahun"/>
                <field name="progres_fisik" widget="percentage"/>
                <field name="pekerja_aktif_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_ksg_operational_monthly_report" model="ir.actions.act_window">
        <field name="name">Laporan Bulanan Proyek</field>
        <field name="res_model">ksg.operational.monthly.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
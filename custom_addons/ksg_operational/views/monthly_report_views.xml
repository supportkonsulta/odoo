<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Laporan Bulanan -->
    <record id="view_ksg_operational_monthly_report_form" model="ir.ui.view">
        <field name="name">ksg.operational.monthly.report.form</field>
        <field name="model">ksg.operational.monthly.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Bulanan Operasional">
                <header>
                    <button name="action_submit" type="object" string="Serahkan ke Manajemen" class="oe_highlight" invisible="state != 'draft'" icon="fa-send"/>
                    <button name="action_approve" type="object" string="Setujui Laporan" class="btn-success" invisible="state != 'submitted'" icon="fa-check"/>
                    <button name="action_reset_draft" type="object" string="Setel ke Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Laporan"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Detail Proyek">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <label for="periode_bulan" string="Bulan &amp; Tahun"/>
                            <div class="d-flex align-items-baseline">
                                <field name="periode_bulan" class="me-2" style="width: 130px;" readonly="state != 'draft'"/>
                                <field name="periode_tahun" style="width: 80px;" readonly="state != 'draft'"/>
                            </div>
                            <field name="author_id"/>
                        </group>
                        <group string="Metrik &amp; Dokumen Pendukung">
                            <field name="pekerja_aktif_count"/>
                            <field name="progres_pekerjaan" widget="progressbar"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file_lampiran" filename="file_name" widget="binary" readonly="state == 'approved'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Aktivitas Lapangan" name="aktivitas">
                            <field name="ringkasan_aktivitas" placeholder="Tuliskan uraian pekerjaan yang diselesaikan bulan ini..."/>
                        </page>
                        <page string="Kendala &amp; Evaluasi Lapangan" name="kendala">
                            <group>
                                <field name="kendala_lapangan" placeholder="Masalah atau kendala yang dihadapi..."/>
                                <field name="solusi_tindakan" placeholder="Tindakan mitigasi atau rencana penanganan..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View Laporan Bulanan -->
    <record id="view_ksg_operational_monthly_report_list" model="ir.ui.view">
        <field name="name">ksg.operational.monthly.report.list</field>
        <field name="model">ksg.operational.monthly.report</field>
        <field name="arch" type="xml">
            <list string="Laporan Bulanan Operasional" decoration-success="state == 'approved'" decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="periode_bulan"/>
                <field name="periode_tahun"/>
                <field name="pekerja_aktif_count"/>
                <field name="progres_pekerjaan" widget="progressbar"/>
                <field name="author_id"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'submitted'" 
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="action_ksg_operational_monthly_report" model="ir.actions.act_window">
        <field name="name">Laporan Bulanan Proyek</field>
        <field name="res_model">ksg.operational.monthly.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

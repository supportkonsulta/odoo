<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ksg_sales_project_form_inherit_operational" model="ir.ui.view">
        <field name="name">ksg.sales.project.form.inherit.operational</field>
        <field name="model">ksg.sales.project</field>
        <field name="inherit_id" ref="ksg_sales.view_ksg_sales_project_form"/>
        <field name="arch" type="xml">

            <!-- Tab Operasional murni tanpa mengubah header form -->
            <xpath expr="//notebook" position="inside">
                <page string="Operasional" name="operational_page">
                    <group>
                        <group string="Estimasi &amp; Penagihan">
                            <field name="total_estimasi_biaya_rencana" widget="monetary"/>
                            <field name="bapbast_ops_ready" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- 1. Rencana Manpower -->
                        <page string="Rencana Manpower" name="plan_manpower">
                            <field name="manpower_plan_ids">
                                <list editable="bottom">
                                    <field name="role"/>
                                    <field name="jumlah"/>
                                    <field name="estimasi_biaya_satuan"/>
                                    <field name="total_biaya"/>
                                </list>
                            </field>
                        </page>

                        <!-- 2. Rencana Perlengkapan -->
                        <page string="Rencana Perlengkapan" name="plan_equipment">
                            <field name="equipment_plan_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="jumlah"/>
                                    <field name="estimasi_biaya_satuan"/>
                                    <field name="total_biaya"/>
                                </list>
                            </field>
                        </page>

                        <!-- 3. Rencana Alat & Bahan -->
                        <page string="Rencana Alat &amp; Bahan" name="plan_material">
                            <field name="material_plan_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="spesifikasi"/>
                                    <field name="jumlah"/>
                                    <field name="satuan"/>
                                </list>
                            </field>
                        </page>

                        <!-- 4. Penugasan Pekerja oleh HC -->
                        <page string="Tenaga Kerja Aktif (HC)" name="active_workers">
                            <field name="assignment_ids" readonly="1">
                                <list>
                                    <field name="worker_id"/>
                                    <field name="tanggal_mulai_tugas"/>
                                    <field name="tanggal_selesai_tugas"/>
                                    <field name="status_aktif"/>
                                </list>
                            </field>
                        </page>

                        <!-- 5. Dokumen Pendukung Tagihan -->
                        <page string="Dokumen Pendukung Tagihan" name="billing_docs">
                            <field name="billing_doc_ids">
                                <list editable="bottom">
                                    <field name="jenis_dokumen"/>
                                    <field name="file_name"/>
                                    <field name="attachment_id" filename="file_name"/>
                                    <field name="uploaded_by" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>

        </field>
    </record>
</odoo>

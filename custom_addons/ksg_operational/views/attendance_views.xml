<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_operational_attendance_report_form" model="ir.ui.view">
        <field name="name">ksg.operational.attendance.report.form</field>
        <field name="model">ksg.operational.attendance.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Presensi">
                <header>
                    <button name="action_verify" type="object" string="Verifikasi &amp; Siap Tagih" class="btn-success" invisible="state == 'verified'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Dokumen"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Proyek &amp; Periode">
                            <field name="project_id" options="{'no_create': True}" readonly="state == 'verified'"/>
                            <field name="periode_bulan" readonly="state == 'verified'"/>
                            <field name="tahun" readonly="state == 'verified'"/>
                        </group>
                        <group string="File Berkas Presensi">
                            <field name="file_presensi" filename="filename" readonly="state == 'verified'"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="catatan" placeholder="Catatan kehadiran..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_operational_attendance_report_list" model="ir.ui.view">
        <field name="name">ksg.operational.attendance.report.list</field>
        <field name="model">ksg.operational.attendance.report</field>
        <field name="arch" type="xml">
            <list string="Laporan Presensi Lapangan" decoration-success="state == 'verified'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="periode_bulan"/>
                <field name="tahun"/>
                <field name="filename"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_ksg_operational_attendance_report" model="ir.actions.act_window">
        <field name="name">Presensi Lapangan</field>
        <field name="res_model">ksg.operational.attendance.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_operational_bast_form" model="ir.ui.view">
        <field name="name">ksg.operational.bast.form</field>
        <field name="model">ksg.operational.bast</field>
        <field name="arch" type="xml">
            <form string="Berita Acara Serah Terima (BAST)">
                <header>
                    <button name="action_verify" type="object" string="Verifikasi &amp; Sahkan BAST" class="btn-success" invisible="state == 'verified'"/>
                    <button name="action_reset_draft" type="object" string="Setel Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor BAST"/>
                        <h1 class="text-primary"><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Data Proyek &amp; Periode">
                            <field name="project_id" options="{'no_create': True}" readonly="state == 'verified'"/>
                            <field name="tanggal_bast" readonly="state == 'verified'"/>
                            <field name="periode_bulan" readonly="state == 'verified'"/>
                            <field name="tahun" readonly="state == 'verified'"/>
                        </group>
                        <group string="Para Pihak &amp; Acuan">
                            <field name="pihak_pertama" readonly="state == 'verified'"/>
                            <field name="pihak_kedua" readonly="state == 'verified'"/>
                            <field name="nomor_kontrak_spk" readonly="state == 'verified'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Berkas BAST &amp; Catatan" name="berkas_tab">
                            <group>
                                <group string="Scan Dokumen BAST Bertandatangan">
                                    <field name="file_bast" filename="filename_bast" readonly="state == 'verified'"/>
                                    <field name="filename_bast" invisible="1"/>
                                </group>
                                <group string="Catatan Serah Terima">
                                    <field name="catatan" placeholder="Keterangan serah terima pekerjaan..." readonly="state == 'verified'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_operational_bast_list" model="ir.ui.view">
        <field name="name">ksg.operational.bast.list</field>
        <field name="model">ksg.operational.bast</field>
        <field name="arch" type="xml">
            <list string="Daftar BAST Operasional" decoration-success="state == 'verified'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="tanggal_bast"/>
                <field name="periode_bulan"/>
                <field name="tahun"/>
                <field name="pihak_pertama"/>
                <field name="nomor_kontrak_spk"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_ksg_operational_bast" model="ir.actions.act_window">
        <field name="name">BAST</field>
        <field name="res_model">ksg.operational.bast</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
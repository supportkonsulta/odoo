<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ksg_operational_assignment_list" model="ir.ui.view">
        <field name="name">ksg.operational.assignment.list</field>
        <field name="model">ksg.operational.assignment</field>
        <field name="arch" type="xml">
            <list string="Penugasan Tenaga Kerja Proyek" decoration-danger="not status_aktif" decoration-success="status_aktif">
                <field name="worker_id"/>
                <field name="project_id"/>
                <field name="tanggal_mulai_tugas"/>
                <field name="tanggal_selesai_tugas"/>
                <field name="status_aktif" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ksg_operational_assignment_form" model="ir.ui.view">
        <field name="name">ksg.operational.assignment.form</field>
        <field name="model">ksg.operational.assignment</field>
        <field name="arch" type="xml">
            <form string="Penugasan Tenaga Kerja Proyek">
                <sheet>
                    <group>
                        <group string="Identitas Tenaga Kerja">
                            <field name="worker_id"/>
                            <field name="project_id"/>
                        </group>
                        <group string="Durasi Penempatan">
                            <field name="tanggal_mulai_tugas"/>
                            <field name="tanggal_selesai_tugas"/>
                            <field name="status_aktif" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ksg_operational_assignment" model="ir.actions.act_window">
        <field name="name">Tenaga Kerja Proyek</field>
        <field name="res_model">ksg.operational.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

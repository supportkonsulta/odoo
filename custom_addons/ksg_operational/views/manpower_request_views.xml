<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_operational_manpower_request_form" model="ir.ui.view">
        <field name="name">ksg.operational.manpower.request.form</field>
        <field name="model">ksg.operational.manpower.request</field>
        <field name="arch" type="xml">
            <form string="Permintaan Tenaga Kerja Lapangan">
                <header>
                    <!-- Operasional HANYA bisa mengirimkan ke HC & setel ulang jika ditolak -->
                    <button name="action_submit" type="object" string="Kirimkan ke HC" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Setel Ulang ke Draft" invisible="state not in ['rejected']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state != 'submitted'">
                        <p class="mb-0"><i class="fa fa-info-circle me-1"/> <strong>Permintaan telah diajukan ke HC.</strong> Menunggu peninjauan, kalkulasi upah/biaya, dan persetujuan oleh Tim Human Capital (HC).</p>
                    </div>
                    <div class="alert alert-success" role="alert" invisible="state != 'approved'">
                        <p class="mb-0"><i class="fa fa-check-circle me-1"/> <strong>Telah Disetujui oleh HC.</strong> Rincian biaya dan perhitungan SDM telah disahkan untuk acuan HPP Penjualan.</p>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'rejected'">
                        <h4 class="alert-heading">Permintaan SDM Ditolak oleh HC!</h4>
                        <p class="mb-0"><strong>Alasan Penolakan: </strong><field name="alasan_penolakan" readonly="1"/></p>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Nomor Permintaan SDM"/>
                        <h1 class="text-primary"><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Informasi Proyek">
                            <field name="project_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="tanggal_pengajuan" readonly="state != 'draft'"/>
                        </group>
                        <group string="Kebutuhan Penugasan Lapangan">
                            <field name="kebutuhan_waktu" placeholder="Contoh: 12 Bulan / Mulai 1 Oktober 2026" readonly="state != 'draft'"/>
                            <field name="total_tenaga_kerja" class="text-primary fs-4 fw-bold"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Plotingan Shift &amp; Posisi Tenaga Kerja (Operasional)" name="plot_lines">
                            <field name="plot_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="jabatan" placeholder="Contoh: TEAM LEADER, CSO"/>
                                    <field name="shift_1" string="Shift 1"/>
                                    <field name="shift_2" string="Shift 2"/>
                                    <field name="libur" string="Libur"/>
                                    <field name="total_tk" sum="Total TK" string="Total"/>
                                    <field name="kualifikasi_khusus"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan untuk Tim HC" name="catatan_page">
                            <group>
                                <field name="catatan" placeholder="Catatan operasional tambahan untuk tim HC..." readonly="state != 'draft'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_operational_manpower_request_list" model="ir.ui.view">
        <field name="name">ksg.operational.manpower.request.list</field>
        <field name="model">ksg.operational.manpower.request</field>
        <field name="arch" type="xml">
            <list string="Permintaan Tenaga Kerja (SDM)" decoration-success="state == 'approved'" decoration-warning="state == 'submitted'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="tanggal_pengajuan"/>
                <field name="kebutuhan_waktu"/>
                <field name="total_tenaga_kerja"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_operational_manpower_request" model="ir.actions.act_window">
        <field name="name">Permintaan Tenaga Kerja</field>
        <field name="res_model">ksg.operational.manpower.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
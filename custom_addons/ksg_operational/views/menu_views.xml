<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_manpower_request" model="ir.actions.act_window">
        <field name="name">Permohonan Manpower</field>
        <field name="res_model">ksg.operational.manpower.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_procurement_request" model="ir.actions.act_window">
        <field name="name">Pengadaan Alat &amp; Bahan (BoQ)</field>
        <field name="res_model">ksg.operational.procurement.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Utama -->
    <menuitem id="menu_ksg_operational_root" 
              name="Operasional" 
              web_icon="ksg_operational,static/description/icon.png"
              sequence="25"/>

    <menuitem id="menu_ksg_operational_manpower" 
              name="Permohonan Manpower" 
              parent="menu_ksg_operational_root" 
              action="action_manpower_request" 
              sequence="10"/>

    <menuitem id="menu_ksg_operational_procurement" 
              name="Pengadaan &amp; BoQ" 
              parent="menu_ksg_operational_root" 
              action="action_procurement_request" 
              sequence="20"/>
</odoo>
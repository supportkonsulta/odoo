<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_ksg_operational_procurement_form" model="ir.ui.view">
        <field name="name">ksg.operational.procurement.request.form</field>
        <field name="model">ksg.operational.procurement.request</field>
        <field name="arch" type="xml">
            <form string="Pengadaan Alat &amp; Bahan (BoQ)">
                <header>
                    <button name="action_submit" type="object" string="Ajukan ke Direktur" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Setujui" class="btn-success" invisible="state != 'waiting_approval'"/>
                    <button name="action_reject" type="object" string="Tolak" class="btn-danger" invisible="state != 'waiting_approval'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="requested_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rincian Barang (BoQ)">
                            <field name="boq_line_ids" readonly="state in ['approved', 'rejected']">
                                <list editable="bottom">
                                    <field name="item"/>
                                    <field name="spesifikasi"/>
                                    <field name="jumlah"/>
                                    <field name="satuan"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan / Penolakan" invisible="not catatan_penolakan">
                            <field name="catatan_penolakan" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_ksg_operational_procurement_list" model="ir.ui.view">
        <field name="name">ksg.operational.procurement.request.list</field>
        <field name="model">ksg.operational.procurement.request</field>
        <field name="arch" type="xml">
            <list string="Pengadaan Alat &amp; Bahan (BoQ)">
                <field name="name"/>
                <field name="project_id"/>
                <field name="requested_by"/>
                <field name="create_date" string="Tanggal Pengajuan"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'waiting_approval'" 
                       decoration-success="state == 'approved'" 
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_ksg_operational_procurement" model="ir.actions.act_window">
        <field name="name">Pengadaan Alat &amp; Bahan (BoQ)</field>
        <field name="res_model">ksg.operational.procurement.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

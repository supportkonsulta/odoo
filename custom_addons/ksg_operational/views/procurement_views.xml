<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_request_form" model="ir.ui.view">
        <field name="name">ksg.operational.procurement.request.form</field>
        <field name="model">ksg.operational.procurement.request</field>
        <field name="arch" type="xml">
            <form string="Pengadaan Alat &amp; Bahan (BoQ)">
                <header>
                    <button name="action_submit" string="Ajukan ke Direktur" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Setujui (Direktur)" type="object" class="btn-success" groups="ksg_operational.group_operational_direktur" invisible="state != 'waiting_approval'"/>
                    <button name="action_reject" string="Tolak" type="object" class="btn-danger" groups="ksg_operational.group_operational_direktur" invisible="state != 'waiting_approval'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="requested_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="catatan_penolakan" invisible="state != 'rejected'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rincian Barang &amp; Spesifikasi (BoQ)">
                            <field name="boq_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="item"/>
                                    <field name="spesifikasi"/>
                                    <field name="satuan"/>
                                    <field name="jumlah"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
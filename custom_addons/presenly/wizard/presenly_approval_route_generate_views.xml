<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_presenly_approval_route_generate_wizard_form" model="ir.ui.view">
        <field name="name">presenly.approval.route.generate.wizard.form</field>
        <field name="model">presenly.approval.route.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Approval Routes">
                <sheet>
                    <div class="oe_title">
                        <h1>Generate Approval Routes</h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        One route step (10, 20, 30, ...) will be created per request
                        type that has no complete company-default route yet. Existing
                        routes are never modified. Browse the preview below: it
                        refreshes as soon as you change the scope or select types.
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="company_id"/>
                            <field name="apply_to"/>
                            <field name="leave_type_ids"
                                   widget="many2many_tags"
                                   invisible="apply_to not in ('all', 'leave')"
                                   options="{'no_create_edit': True}"/>
                            <field name="permission_type_ids"
                                   widget="many2many_tags"
                                   invisible="apply_to not in ('all', 'permission')"
                                   options="{'no_create_edit': True}"/>
                            <field name="work_location_id"
                                   options="{'no_create_edit': True}"
                                   help="Leave empty for the company default route (recommended)."/>
                        </group>
                        <group string="Approver">
                            <field name="approver_type"/>
                            <field name="approver_user_id"
                                   widget="many2one_avatar_user"
                                   options="{'no_create_edit': True}"
                                   invisible="approver_type != 'user'"/>
                            <field name="approver_group_id"
                                   options="{'no_create_edit': True}"
                                   invisible="approver_type != 'group'"/>
                        </group>
                        <group string="Ordering">
                            <field name="skip_existing"/>
                        </group>
                    </group>
                    <div class="d-flex gap-3 mb-2">
                        <div>
                            <span class="text-muted">Total rows:</span>
                            <span class="badge text-bg-primary"><field name="line_count"/></span>
                        </div>
                        <div>
                            <span class="text-muted">To create:</span>
                            <span class="badge text-bg-success"><field name="to_create_count"/></span>
                        </div>
                        <div>
                            <span class="text-muted">Already routed (skipped):</span>
                            <span class="badge text-bg-secondary"><field name="skipped_count"/></span>
                        </div>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="to_create_count or not line_count">
                        <i class="fa fa-info-circle me-1" title="All routed" aria-label="All routed"/>
                        <strong>All selected request types already have a complete
                        route</strong> (rows show “Already Routed”). Nothing new will
                        be created. Uncheck <em>Skip existing</em> to add another
                        approval step to these routes, or pick different types.
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list create="0" edit="0" delete="0"
                              default_order="sequence, id">
                            <field name="sequence" string="Order"/>
                            <field name="request_name" string="Request Type"/>
                            <field name="request_kind" string="Kind"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'to_create'"
                                   decoration-muted="status == 'skipped'"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate Routes" class="btn-primary"
                            invisible="not to_create_count"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_presenly_approval_route_generate" model="ir.actions.act_window">
        <field name="name">Generate Approval Routes</field>
        <field name="res_model">presenly.approval.route.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate Approval Routes</p>
            <p>Create one route step per Time Off Type, Permission Type, and Overtime.</p>
        </field>
    </record>
</odoo>
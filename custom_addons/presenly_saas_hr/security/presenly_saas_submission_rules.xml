        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_presenly_saas_shift_swap_branch_hr" model="ir.rule">
        <field name="name">Presenly SaaS shift swap: HR sees every branch</field>
        <field name="model_id" ref="presenly_saas.model_presenly_saas_shift_swap"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <!-- Seluruh cabang di perusahaan yang ia diizinkan: itulah pagar tenant,

#. module: presenly_saas_hr
#. odoo-python
#: code:addons/presenly_saas_hr/models/presenly_saas_employee_mirror.py:0
msgid ""
"%(name)s (nopeg %(nopeg)s): changed in both systems; the Presenly value was "
"kept. Review it in Odoo."
msgstr ""
"%(name)s (nopeg %(nopeg)s): berubah di kedua sisi; nilai dari Presenly yang "
"dipakai. Periksa di Odoo."

#. module: presenly_saas_hr
#. odoo-python
#: code:addons/presenly_saas_hr/models/presenly_saas_employee_mirror.py:0
#: code:addons/presenly_saas_hr/tests/test_employee_sync.py:0
msgid ""
"%(name)s (nopeg %(nopeg)s): more than one Odoo employee carries this nopeg, "
"so none was touched."
msgstr ""
"%(name)s (nopeg %(nopeg)s): lebih dari satu pegawai Odoo memakai nopeg ini, "
"jadi tidak ada yang disentuh."

#. module: presenly_saas_hr
#. odoo-python
#: code:addons/presenly_saas_hr/models/presenly_saas_employee_mirror.py:0
#: code:addons/presenly_saas_hr/tests/test_employee_sync.py:0
msgid ""
"%(name)s: Presenly marks this employee inactive, but the Odoo employee has a"
" user account. Deactivate it in Odoo if that is really intended."
msgstr ""
"%(name)s: Presenly menandai pegawai ini tidak aktif, tetapi pegawai Odoo-nya"
" punya akun pengguna. Nonaktifkan di Odoo kalau memang itu yang diinginkan."

#. module: presenly_saas_hr
#. odoo-python
#: code:addons/presenly_saas_hr/models/presenly_saas_employee_mirror.py:0
msgid "%(name)s: could not be linked to an Odoo employee."
msgstr "%(name)s: tidak bisa ditautkan ke pegawai Odoo."

#. module: presenly_saas_hr
#. odoo-python
#: code:addons/presenly_saas_hr/models/presenly_saas_employee_mirror.py:0
msgid "%(name)s: no nopeg, so there is no key to link on."
msgstr "%(name)s: tanpa nopeg, jadi tidak ada kunci untuk menautkan."

#. module: presenly_saas_hr
#. odoo-python
#: code:addons/presenly_saas_hr/models/presenly_saas_config_hr.py:0

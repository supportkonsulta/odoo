<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

            <!-- Sinkronisasi pegawai dua arah. Terpisah dari penarikan periode
                 karena menyentuh hr.employee, dan kegagalannya tidak boleh
                 menghentikan penarikan presensi. -->
            <record id="ir_cron_presenly_saas_sync_employees" model="ir.cron">
                <field name="name">Presenly SaaS: Sync Employees</field>
                <field name="model_id" ref="model_presenly_saas_config"/>
                <field name="state">code</field>
                <field name="code">model._cron_sync_employees_all()</field>
                <field name="interval_number">1</field>
                <field name="interval_type">days</field>
                <field name="user_id" ref="base.user_root"/>
            </record>

    </data>

</odoo>

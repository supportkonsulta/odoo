<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Tombol keputusan pada form pengajuan cuti.

        Diletakkan **di dalam kelompok Approval** yang sudah ada, bukan di
        `<header>` tersendiri. Form ini tidak punya status bar, jadi header
        tambahan hanya menghasilkan bilah kosong berisi satu tombol di atas kartu —
        dan sekaligus memisahkan tombol dari rangkaian langkah yang menjelaskan
        kenapa tombolnya ada di sana.

        Yang menentukannya bukan layout, melainkan `presenly_can_decide`: tombol
        hanya muncul untuk pengguna yang menurut langkah persetujuan berhak
        memutuskan level yang berjalan. Server tetap memeriksa hal yang sama, dan
        penolakannya ditampilkan.
    -->

    <record id="view_presenly_saas_leave_form_decide" model="ir.ui.view">
        <field name="name">presenly.saas.leave.form.decide</field>
        <field name="model">presenly.saas.leave</field>
        <field name="inherit_id" ref="presenly_saas.view_presenly_saas_leave_form"/>
        <field name="arch" type="xml">
            <!-- Penandanya field, bukan atribut `string`: Odoo melarang `string`
                 sebagai pemilih xpath karena bisa diterjemahkan. -->
            <xpath expr="//field[@name='approval_step_ids']" position="before">
                <div class="d-flex justify-content-end align-items-center gap-2">
                    <field name="presenly_can_decide" invisible="1"/>
                    <field name="presenly_decidable" invisible="1"/>
                    <button name="action_presenly_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            invisible="not presenly_can_decide"/>
                    <button name="action_presenly_reject"
                            type="object"
                            string="Reject"
                            invisible="not presenly_can_decide"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>

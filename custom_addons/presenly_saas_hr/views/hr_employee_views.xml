<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Kolom nopeg di form pegawai, supaya pegawai yang tidak berhasil
        dicocokkan tarikan bisa ditautkan manual. Yang bisa melihat dan
        mengisinya hanya manajer: menyunting nopeg berarti menautkan data
        kepegawaian ke orang di sistem lain.
    -->

    <record id="view_employee_form_presenly" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.presenly.saas.hr</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_title']" position="after">
                <field name="presenly_nopeg"
                       placeholder="e.g. iksg-rangga"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_synced_at"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_saas_config_id"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_group"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_role"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_shift"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_can_approve"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_no_npwp"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_no_rekening"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_no_bpjs"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_no_bpjs_kes"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager"/>
                <field name="presenly_schedule_ids"
                       readonly="1"
                       groups="presenly_saas.group_presenly_saas_manager">
                    <list create="false" edit="false" delete="false">
                        <field name="day_of_week"/>
                        <field name="is_workday"/>
                        <field name="location_name"/>
                        <field name="shift_name"/>
                        <field name="status" optional="show"/>
                        <field name="valid_from" optional="hide"/>
                        <field name="valid_until" optional="hide"/>
                    </list>
                </field>
                <field name="presenly_synced_values" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>

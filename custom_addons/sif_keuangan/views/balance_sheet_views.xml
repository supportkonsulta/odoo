<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Action untuk Balance Sheet Interaktif Full-Page -->
    <record id="action_sif_balance_sheet_client" model="ir.actions.client">
        <field name="name">Balance Sheet</field>
        <field name="tag">sif_keuangan.balance_sheet</field>
        <field name="target">main</field>
    </record>

    <!-- Wizard Form View (Fallback jika dipanggil lewat form dialog) -->
    <record id="view_sif_balance_sheet_wizard_form" model="ir.ui.view">
        <field name="name">sif.balance.sheet.wizard.form</field>
        <field name="model">sif.balance.sheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Cetak Laporan Balance Sheet">
                <sheet>
                    <div class="oe_title">
                        <h2>Laporan Balance Sheet (Neraca)</h2>
                    </div>
                    <group>
                        <group string="Periode &amp; Filter">
                            <field name="date_to" required="1"/>
                            <field name="target_move" widget="radio"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Cetak PDF" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" string="Ekspor Excel (XLSX)" type="object" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action Window untuk Wizard -->
    <record id="action_sif_balance_sheet_wizard" model="ir.actions.act_window">
        <field name="name">Balance Sheet (Wizard)</field>
        <field name="res_model">sif.balance.sheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>

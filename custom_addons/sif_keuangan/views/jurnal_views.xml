<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM JURNAL TRANSAKSI -->
    <record id="view_sif_jurnal_entry_form" model="ir.ui.view">
        <field name="name">sif.jurnal.entry.form</field>
        <field name="model">sif.jurnal.entry</field>
        <field name="arch" type="xml">
            <form string="Input Jurnal Transaksi">
                <header>
                    <button name="action_post" string="Validasi / Posting" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Kembalikan ke Draft" type="object" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state == 'posted'"/>
                            <field name="reference" readonly="state == 'posted'"/>
                            <field name="source_document"/>
                        </group>
                        <group>
                            <field name="unit_dept" readonly="state == 'posted'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Baris Jurnal">
                            <field name="line_ids" readonly="state == 'posted'">
                                <list editable="bottom">
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="debit" sum="Total Debit"/>
                                    <field name="credit" sum="Total Kredit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sif_jurnal_entry_tree" model="ir.ui.view">
        <field name="name">sif.jurnal.entry.list</field>
        <field name="model">sif.jurnal.entry</field>
        <field name="arch" type="xml">
            <list string="Daftar Jurnal Umum">
                <field name="date"/>
                <field name="name"/>
                <field name="reference"/>
                <field name="source_document"/>
                <field name="unit_dept"/>
                <field name="total_debit"/>
                <field name="total_credit"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="action_sif_jurnal_entry" model="ir.actions.act_window">
        <field name="name">Input Jurnal Dasar</field>
        <field name="res_model">sif.jurnal.entry</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- LIST VIEW BUKU BESAR DENGAN RUNNING BALANCE & PERIODE -->
    <record id="view_sif_buku_besar_tree" model="ir.ui.view">
        <field name="name">sif.jurnal.line.buku.besar.list</field>
        <field name="model">sif.jurnal.line</field>
        <field name="arch" type="xml">
            <list string="Buku Besar" create="false" edit="false">
                <field name="date"/>
                <field name="account_id"/>
                <field name="account_type"/>
                <field name="entry_id" string="No. Referensi Jurnal"/>
                <field name="name" string="Keterangan"/>
                <field name="unit_dept"/>
                <field name="debit" sum="Total Debit"/>
                <field name="credit" sum="Total Kredit"/>
                <field name="balance" sum="Total Saldo Mutasi"/>
                <field name="period_key" string="Periode" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW & FILTER BULANAN BUKU BESAR (SRS 3.3.2) -->
    <record id="view_sif_buku_besar_search" model="ir.ui.view">
        <field name="name">sif.jurnal.line.search</field>
        <field name="model">sif.jurnal.line</field>
        <field name="arch" type="xml">
            <search string="Pencarian Buku Besar">
                <field name="account_id"/>
                <field name="unit_dept"/>
                <field name="entry_id"/>
                <field name="period_key"/>
                
                <!-- Filter Status Posted -->
                <filter string="Sudah Diposting" name="filter_posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                
                <!-- Filter Periode Bulanan Spesifik -->
                <filter string="Januari" name="m_01" domain="[('period_month', '=', '01')]"/>
                <filter string="Februari" name="m_02" domain="[('period_month', '=', '02')]"/>
                <filter string="Maret" name="m_03" domain="[('period_month', '=', '03')]"/>
                <filter string="April" name="m_04" domain="[('period_month', '=', '04')]"/>
                <filter string="Mei" name="m_05" domain="[('period_month', '=', '05')]"/>
                <filter string="Juni" name="m_06" domain="[('period_month', '=', '06')]"/>
                <filter string="Juli" name="m_07" domain="[('period_month', '=', '07')]"/>
                <filter string="Agustus" name="m_08" domain="[('period_month', '=', '08')]"/>
                <filter string="September" name="m_09" domain="[('period_month', '=', '09')]"/>
                <filter string="Oktober" name="m_10" domain="[('period_month', '=', '10')]"/>
                <filter string="November" name="m_11" domain="[('period_month', '=', '11')]"/>
                <filter string="Desember" name="m_12" domain="[('period_month', '=', '12')]"/>
                <separator/>
                
                <!-- Grouping -->
                <filter string="Kelompokkan Akun Rekening" name="group_by_account" context="{'group_by': 'account_id'}"/>
                <filter string="Kelompokkan Periode Bulanan" name="group_by_period" context="{'group_by': 'period_key'}"/>
                <filter string="Kelompokkan Unit Kerja" name="group_by_unit" context="{'group_by': 'unit_dept'}"/>
                <filter string="Kelompokkan Tanggal" name="group_by_date" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_sif_buku_besar" model="ir.actions.act_window">
        <field name="name">Buku Besar</field>
        <field name="res_model">sif.jurnal.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_sif_buku_besar_search"/>
        <field name="context">{'search_default_filter_posted': 1, 'search_default_group_by_account': 1}</field>
    </record>
</odoo>

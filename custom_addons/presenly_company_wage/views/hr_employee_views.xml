<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add a "Wages per Company" tab to the Employee form. -->
    <record id="view_hr_employee_form_company_wage" model="ir.ui.view">
        <field name="name">hr.employee.form.company.wage</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="company_wages" string="Wages per Company"
                      groups="hr_payroll_custom.group_payroll_manager">
                    <field name="company_wage_ids"
                           context="{'default_employee_id': id}"
                           domain="[('employee_id', '=', id)]">
                        <list editable="bottom">
                            <field name="work_location_id"
                                   options="{'no_create_edit': True}" required="1"/>
                            <field name="wage" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="valid_from" optional="hide"/>
                            <field name="valid_to" optional="hide"/>
                            <field name="active" optional="hide"/>
                        </list>
                    </field>
                    <div class="text-muted mt16">
                        <p>
                            Fixed basic salary per company (work location). When the
                            employee works for several companies, every payslip uses
                            the wage configured for its own work location. If no wage
                            is set here, the contract wage is used as fallback.
                        </p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

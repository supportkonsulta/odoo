<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_hr_employee_company_wage_list" model="ir.ui.view">
        <field name="name">hr.employee.company.wage.list</field>
        <field name="model">hr.employee.company.wage</field>
        <field name="arch" type="xml">
            <list string="Employee Company Wages" editable="bottom">
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="wage" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="valid_from" optional="hide"/>
                <field name="valid_to" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_employee_company_wage_form" model="ir.ui.view">
        <field name="name">hr.employee.company.wage.form</field>
        <field name="model">hr.employee.company.wage</field>
        <field name="arch" type="xml">
            <form string="Employee Company Wage">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="work_location_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="wage" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_employee_company_wage_search" model="ir.ui.view">
        <field name="name">hr.employee.company.wage.search</field>
        <field name="model">hr.employee.company.wage</field>
        <field name="arch" type="xml">
            <search string="Employee Company Wages">
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <separator/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_work_location" string="Company / Work Location"
                            context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_employee_company_wage" model="ir.actions.act_window">
        <field name="name">Wages per Company</field>
        <field name="res_model">hr.employee.company.wage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_employee_company_wage_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a fixed wage for an employee at a company (work location).
            </p>
        </field>
    </record>

    <!-- Menu: Payroll > Configuration > Wages per Company -->
    <menuitem id="menu_hr_employee_company_wage"
              name="Wages per Company"
              parent="hr_payroll_custom.menu_payroll_configuration"
              action="action_hr_employee_company_wage"
              sequence="15"
              groups="hr_payroll_custom.group_payroll_manager"/>
</odoo>

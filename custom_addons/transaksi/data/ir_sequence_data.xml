<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pastikan mata uang Rupiah aktif -->
    <record id="base.IDR" model="res.currency">
        <field name="active" eval="True"/>
    </record>

    <record id="seq_transaksi_transaction" model="ir.sequence">
        <field name="name">Nomor Transaksi Mutasi Rekening</field>
        <field name="code">transaksi.transaction</field>
        <field name="prefix">TRF/%(year)s%(month)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
        <field name="use_date_range" eval="True"/>
    </record>
</odoo>

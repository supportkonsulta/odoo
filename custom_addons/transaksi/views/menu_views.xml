<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu: Transaksi -->
    <menuitem id="menu_transaksi_root"
              name="Transaksi"
              sequence="25"
              web_icon="transaksi,static/description/icon.png"/>

    <!-- Submenu: Mutasi Bank -->
    <menuitem id="menu_transaksi_main"
              name="Mutasi Bank"
              parent="menu_transaksi_root"
              sequence="10"/>

    <!-- Menu Item: Mutasi Antar Rekening -->
    <menuitem id="menu_transaksi_all"
              name="Mutasi Antar Rekening"
              parent="menu_transaksi_main"
              action="action_transaksi_transaction"
              sequence="10"/>

    <!-- Submenu: Persetujuan (Approval) -->
    <menuitem id="menu_transaksi_approval"
              name="Antrean Persetujuan"
              parent="menu_transaksi_root"
              groups="transaksi.group_transaksi_finance,transaksi.group_transaksi_director,transaksi.group_transaksi_manager,base.group_erp_manager,base.group_system"
              sequence="20"/>

    <!-- Actions for approval filters -->
    <record id="action_transaksi_transaction_to_verify" model="ir.actions.act_window">
        <field name="name">Menunggu Verifikasi Keuangan</field>
        <field name="res_model">transaksi.transaction</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="context">{'default_state': 'draft'}</field>
    </record>

    <record id="action_transaksi_transaction_to_approve" model="ir.actions.act_window">
        <field name="name">Menunggu Persetujuan Direktur</field>
        <field name="res_model">transaksi.transaction</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'verified')]</field>
        <field name="context">{'default_state': 'draft'}</field>
    </record>

    <menuitem id="menu_transaksi_to_verify"
              name="Verifikasi Keuangan"
              parent="menu_transaksi_approval"
              action="action_transaksi_transaction_to_verify"
              groups="transaksi.group_transaksi_finance,transaksi.group_transaksi_manager,base.group_erp_manager,base.group_system"
              sequence="10"/>

    <menuitem id="menu_transaksi_to_approve"
              name="Persetujuan Direktur"
              parent="menu_transaksi_approval"
              action="action_transaksi_transaction_to_approve"
              groups="transaksi.group_transaksi_director,transaksi.group_transaksi_manager,base.group_erp_manager,base.group_system"
              sequence="20"/>
</odoo>

    <!-- Rule: WBS by assignment -->
    <record id="rule_wbs_by_assignment" model="ir.rule">
        <field name="name">Engineering: WBS by Assignment</field>
        <field name="model_id" ref="model_ksg_engineering_wbs"/>
        <field name="domain_force">[('project_id', 'in', user.assigned_project_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_pelaksana')),
                                    (4, ref('group_engineer')),
                                    (4, ref('group_pengawas')),
                                    (4, ref('group_supervisor'))]"/>
    </record>

    <!-- Rule: Daily Report by assignment -->
    <record id="rule_daily_by_assignment" model="ir.rule">
        <field name="name">Engineering: Daily Report by Assignment</field>
        <field name="model_id" ref="model_ksg_engineering_daily_report"/>
        <field name="domain_force">[('project_id', 'in', user.assigned_project_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_pelaksana')),
                                    (4, ref('group_engineer')),
                                    (4, ref('group_pengawas')),
                                    (4, ref('group_supervisor'))]"/>
    </record>

    <!-- Rule: Consolidation by assignment -->
    <record id="rule_consolidation_by_assignment" model="ir.rule">
        <field name="name">Engineering: Consolidation by Assignment</field>
        <field name="model_id" ref="model_ksg_engineering_report_consolidation"/>
        <field name="domain_force">[('project_id', 'in', user.assigned_project_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_pelaksana')),
                                    (4, ref('group_engineer')),
                                    (4, ref('group_pengawas')),
                                    (4, ref('group_supervisor'))]"/>
    </record>

    <!-- Rule: BAPBAST by assignment -->
    <record id="rule_bapbast_by_assignment" model="ir.rule">
        <field name="name">Engineering: BAP/BAST by Assignment</field>
        <field name="model_id" ref="model_ksg_engineering_bapbast"/>
        <field name="domain_force">[('project_id', 'in', user.assigned_project_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_pelaksana')),
                                    (4, ref('group_engineer')),
                                    (4, ref('group_pengawas')),
                                    (4, ref('group_supervisor'))]"/>
    </record>

    <!-- Penagihan: read-only global (tanpa domain assignment) -->
    <record id="rule_penagihan_global_read" model="ir.rule">
        <field name="name">Engineering: Penagihan Read-only Global</field>
        <field name="model_id" ref="ksg_sales.model_ksg_sales_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_penagihan'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>

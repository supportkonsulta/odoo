<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Groups (Section 4.1) -->
    <!-- ============================================================ -->
    <record id="group_pelaksana" model="res.groups">
        <field name="name">Engineering / Pelaksana</field>
    </record>

    <record id="group_engineer" model="res.groups">
        <field name="name">Engineering / Engineer</field>
    </record>

    <record id="group_pengawas" model="res.groups">
        <field name="name">Engineering / Pengawas</field>
    </record>

    <record id="group_supervisor" model="res.groups">
        <field name="name">Engineering / Supervisor</field>
    </record>

    <record id="group_kepala_unit" model="res.groups">
        <field name="name">Engineering / Kepala Unit</field>
        <field name="implied_ids" eval="[(4, ref('group_supervisor'))]"/>
    </record>

    <!-- Penagihan: group sendiri karena ksg_sales tidak punya group_penagihan -->
    <record id="group_penagihan" model="res.groups">
        <field name="name">Engineering / Penagihan (Read-only)</field>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules (Section 4.2) -->
    <!-- Tidak menimpa rule Sales (Sales tidak punya ir.rule) -->
    <!-- ============================================================ -->

    <!-- Rule: Project by assignment (Pelaksana, Engineer, Pengawas, Supervisor) -->
    <record id="rule_project_by_assignment" model="ir.rule">
        <field name="name">Engineering: Project by Assignment</field>
        <field name="model_id" ref="ksg_sales.model_ksg_sales_project"/>
        <field name="domain_force">[('id', 'in', user.assigned_project_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_pelaksana')),
                                    (4, ref('group_engineer')),
                                    (4, ref('group_pengawas')),
                                    (4, ref('group_supervisor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>


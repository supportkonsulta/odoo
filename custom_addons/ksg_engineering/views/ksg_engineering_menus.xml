<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Actions -->
    <!-- ============================================================ -->

    <!-- Dashboard -->
    <record id="action_engineering_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Engineering</field>
        <field name="res_model">ksg.sales.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('kategori.name', 'in', ['Engineering dan Supervisi', 'Tenaga Ahli'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada project Engineering.
            </p>
            <p>Project akan muncul di sini setelah dibuat di modul Penjualan dengan kategori "Engineering dan Supervisi" atau "Tenaga Ahli".</p>
        </field>
    </record>

    <record id="action_engineering_dashboard_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_engineering_dashboard_kanban"/>
        <field name="act_window_id" ref="action_engineering_dashboard"/>
    </record>

    <record id="action_engineering_dashboard_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="act_window_id" ref="action_engineering_dashboard"/>
    </record>

    <record id="action_engineering_dashboard_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_engineering_project_form"/>
        <field name="act_window_id" ref="action_engineering_dashboard"/>
    </record>

    <!-- Projects -->
    <record id="action_engineering_projects" model="ir.actions.act_window">
        <field name="name">Semua Project Engineering</field>
        <field name="res_model">ksg.sales.project</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kategori.name', 'in', ['Engineering dan Supervisi', 'Tenaga Ahli'])]</field>
    </record>

    <record id="action_engineering_projects_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="act_window_id" ref="action_engineering_projects"/>
    </record>

    <record id="action_engineering_projects_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_engineering_project_form"/>
        <field name="act_window_id" ref="action_engineering_projects"/>
    </record>

    <!-- WBS -->
    <record id="action_engineering_wbs" model="ir.actions.act_window">
        <field name="name">WBS (Rincian Pekerjaan)</field>
        <field name="res_model">ksg.engineering.wbs</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wbs_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada Rincian Pekerjaan.</p>
            <p>Hanya menampilkan pekerjaan Induk (Utama). Sub-pekerjaan bisa dilihat/ditambah di dalam form Induk tersebut.</p>
        </field>
    </record>

    <!-- Daily Reports -->
    <record id="action_engineering_daily_reports" model="ir.actions.act_window">
        <field name="name">Laporan Harian</field>
        <field name="res_model">ksg.engineering.daily.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_daily_report_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <!-- Consolidations -->
    <record id="action_engineering_consolidations" model="ir.actions.act_window">
        <field name="name">Konsolidasi Laporan</field>
        <field name="res_model">ksg.engineering.report.consolidation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_consolidation_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <!-- Weekly Reports -->
    <record id="action_engineering_weekly_reports" model="ir.actions.act_window">
        <field name="name">Laporan Mingguan</field>
        <field name="res_model">ksg.engineering.weekly.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_weekly_report_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <!-- Monthly Reports -->
    <record id="action_engineering_monthly_reports" model="ir.actions.act_window">
        <field name="name">Laporan Bulanan</field>
        <field name="res_model">ksg.engineering.monthly.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_monthly_report_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <!-- BAP/BAST -->
    <record id="action_engineering_bapbast" model="ir.actions.act_window">
        <field name="name">BAP/BAST</field>
        <field name="res_model">ksg.engineering.bapbast</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bapbast_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <!-- Assignments -->
    <record id="action_engineering_assignments" model="ir.actions.act_window">
        <field name="name">Penugasan Personel</field>
        <field name="res_model">ksg.engineering.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assignment_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <!-- Schedule Weeks -->
    <record id="view_schedule_week_tree" model="ir.ui.view">
        <field name="name">ksg.engineering.schedule.week.list</field>
        <field name="model">ksg.engineering.schedule.week</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="project_id, no_minggu" string="Kalender Minggu">
                <field name="project_id" string="Nama Proyek"/>
                <field name="no_minggu" string="Minggu Ke-" sum=""/>
                <field name="tanggal_mulai" string="Tanggal Mulai"/>
                <field name="tanggal_selesai" string="Tanggal Selesai"/>
            </list>
        </field>
    </record>

    <record id="view_schedule_week_search" model="ir.ui.view">
        <field name="name">ksg.engineering.schedule.week.search</field>
        <field name="model">ksg.engineering.schedule.week</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_engineering_schedule_weeks" model="ir.actions.act_window">
        <field name="name">Kalender Minggu</field>
        <field name="res_model">ksg.engineering.schedule.week</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_schedule_week_tree"/>
        <field name="search_view_id" ref="view_schedule_week_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <!-- ============================================================ -->
    <!-- Root Menu -->
    <!-- ============================================================ -->
    <menuitem id="menu_engineering_root"
              name="Engineering"
              web_icon="ksg_engineering,static/description/icon.png"
              sequence="40"/>

    <!-- ============================================================ -->
    <!-- Level 1: Monitoring -->
    <!-- ============================================================ -->
    <menuitem id="menu_engineering_dashboard"
              name="Dashboard"
              parent="menu_engineering_root"
              action="action_engineering_dashboard"
              sequence="10"/>

    <menuitem id="menu_engineering_projects"
              name="Semua Project"
              parent="menu_engineering_root"
              action="action_engineering_projects"
              sequence="15"/>

    <!-- ============================================================ -->
    <!-- Level 1: Perencanaan -->
    <!-- ============================================================ -->
    <menuitem id="menu_engineering_planning"
              name="Perencanaan"
              parent="menu_engineering_root"
              sequence="20"/>

    <menuitem id="menu_engineering_wbs"
              name="WBS (Rincian Pekerjaan)"
              parent="menu_engineering_planning"
              action="action_engineering_wbs"
              sequence="10"/>

    <menuitem id="menu_engineering_assignment"
              name="Penugasan Personel"
              parent="menu_engineering_planning"
              action="action_engineering_assignments"
              sequence="20"/>

    <!-- ============================================================ -->
    <!-- Level 1: Pelaksanaan & Pelaporan -->
    <!-- ============================================================ -->
    <menuitem id="menu_engineering_execution"
              name="Pelaksanaan"
              parent="menu_engineering_root"
              sequence="30"/>

    <menuitem id="menu_engineering_daily"
              name="Laporan Harian"
              parent="menu_engineering_execution"
              action="action_engineering_daily_reports"
              sequence="10"/>

    <menuitem id="menu_engineering_consolidation"
              name="Konsolidasi"
              parent="menu_engineering_execution"
              action="action_engineering_consolidations"
              sequence="20"/>

    <menuitem id="menu_engineering_weekly"
              name="Laporan Mingguan"
              parent="menu_engineering_execution"
              action="action_engineering_weekly_reports"
              sequence="30"/>

    <menuitem id="menu_engineering_monthly"
              name="Laporan Bulanan"
              parent="menu_engineering_execution"
              action="action_engineering_monthly_reports"
              sequence="40"/>

    <!-- ============================================================ -->
    <!-- Level 1: Serah Terima -->
    <!-- ============================================================ -->
    <menuitem id="menu_engineering_bapbast"
              name="BAP/BAST"
              parent="menu_engineering_root"
              action="action_engineering_bapbast"
              sequence="40"/>

    <!-- ============================================================ -->
    <!-- Level 1: Konfigurasi -->
    <!-- ============================================================ -->
    <menuitem id="menu_engineering_config"
              name="Konfigurasi"
              parent="menu_engineering_root"
              sequence="100"
              groups="ksg_engineering.group_kepala_unit,base.group_system"/>

    <menuitem id="menu_engineering_schedule_weeks"
              name="Kalender Minggu"
              parent="menu_engineering_config"
              action="action_engineering_schedule_weeks"
              sequence="10"/>
</odoo>

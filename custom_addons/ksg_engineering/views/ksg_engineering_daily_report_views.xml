<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Daily Report Views -->
    <!-- ============================================================ -->

    <!-- List -->
    <record id="view_daily_report_tree" model="ir.ui.view">
        <field name="name">ksg.engineering.daily.report.list</field>
        <field name="model">ksg.engineering.daily.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="tanggal"/>
                <field name="pelaksana_id" string="Pelaksana"/>
                <field name="state" string="Status" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_daily_report_search" model="ir.ui.view">
        <field name="name">ksg.engineering.daily.report.search</field>
        <field name="model">ksg.engineering.daily.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="pelaksana_id"/>
                <field name="tanggal"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <!-- Form -->
    <record id="view_daily_report_form" model="ir.ui.view">
        <field name="name">ksg.engineering.daily.report.form</field>
        <field name="model">ksg.engineering.daily.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit Laporan"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="ksg_engineering.group_pelaksana,ksg_engineering.group_engineer,ksg_engineering.group_pengawas,base.group_system"/>
                    <button name="action_reset_draft" string="Batalkan Submit"
                            type="object" class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="ksg_engineering.group_pengawas,ksg_engineering.group_supervisor,base.group_system"
                            confirm="Laporan akan dikembalikan ke Draft. Lanjutkan?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group string="Informasi Laporan">
                            <field name="project_id"
                                   readonly="state == 'submitted'"
                                   options="{'no_create': 1}"/>
                            <field name="tanggal"
                                   readonly="state == 'submitted'"/>
                        </group>
                        <group string="Pelaksana">
                            <field name="pelaksana_id"
                                   readonly="state == 'submitted'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail Pekerjaan Hari Ini">
                            <field name="line_ids" nolabel="1"
                                   readonly="state == 'submitted'">
                                <list>
                                    <field name="wbs_id" string="Pekerjaan (WBS)"/>
                                    <field name="jam_mulai" widget="float_time" string="Mulai"/>
                                    <field name="jam_selesai" widget="float_time" string="Selesai"/>
                                    <field name="progress" string="Progress (%)"/>
                                    <field name="deskripsi" string="Keterangan" optional="show"/>
                                </list>
                                <form string="Form Detail Pekerjaan">
                                    <sheet>
                                        <group>
                                            <group string="Pekerjaan">
                                                <field name="project_id" invisible="1"/>
                                    <field name="wbs_id" string="Pilih Pekerjaan (WBS)"
                                           domain="[('project_id', '=', parent.project_id), ('child_ids', '=', False)]"
                                           options="{'no_create': 1}"/>
                                                <field name="progress" string="Progress Hari ini (%)"
                                                       placeholder="Contoh: 10"/>
                                            </group>
                                            <group string="Waktu &amp; Pekerja">
                                                <field name="jam_mulai" widget="float_time"/>
                                                <field name="jam_selesai" widget="float_time"/>
                                                <field name="personel_ids" widget="many2many_tags"
                                                       string="Tim Pekerja"/>
                                            </group>
                                        </group>
                                        <group string="Dokumentasi">
                                            <field name="deskripsi" string="Keterangan / Kendala"
                                                   placeholder="Jelaskan apa yang dikerjakan..."/>
                                            <field name="evidence_ids" widget="many2many_binary"
                                                   string="Upload Foto/Bukti"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>

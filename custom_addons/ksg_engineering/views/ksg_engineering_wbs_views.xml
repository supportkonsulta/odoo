<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- WBS Views -->
    <!-- ============================================================ -->

    <!-- List: Grouped by Project -->
    <record id="view_wbs_tree" model="ir.ui.view">
        <field name="name">ksg.engineering.wbs.list</field>
        <field name="model">ksg.engineering.wbs</field>
        <field name="arch" type="xml">
            <list default_order="project_id, id"
                  decoration-bf="not parent_id">
                <field name="project_id"/>
                <field name="parent_id" string="Induk" optional="show"/>
                <field name="display_name" string="Nama Pekerjaan"/>
                <field name="nilai_pekerjaan" string="Nilai (Rp)" sum="Total"/>
                <field name="bobot" string="Bobot (%)" sum="Total"/>
                <field name="tanggal_mulai"/>
                <field name="tanggal_selesai"/>
                <field name="planned_progress_kumulatif" string="Rencana (%)"/>
                <field name="actual_progress_kumulatif" string="Realisasi (%)"/>
            </list>
        </field>
    </record>

    <!-- Search View untuk Group By Default -->
    <record id="view_wbs_search" model="ir.ui.view">
        <field name="name">ksg.engineering.wbs.search</field>
        <field name="model">ksg.engineering.wbs</field>
        <field name="arch" type="xml">
            <search>
                <field name="nama_pekerjaan"/>
                <field name="project_id"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <!-- Form -->
    <record id="view_wbs_form" model="ir.ui.view">
        <field name="name">ksg.engineering.wbs.form</field>
        <field name="model">ksg.engineering.wbs</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title mb-3">
                        <label for="nama_pekerjaan" string="Nama Pekerjaan"/>
                        <h1><field name="nama_pekerjaan" placeholder="Contoh: Pekerjaan Pondasi..."/></h1>
                    </div>
                    <group>
                        <group string="Identitas">
                            <field name="project_id"/>
                            <field name="parent_id" string="Induk Pekerjaan"
                                   domain="[('project_id', '=', project_id)]"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Nilai &amp; Bobot">
                            <field name="nilai_pekerjaan"/>
                            <field name="bobot" readonly="1" string="Bobot Otomatis (%)"/>
                            <field name="volume"/>
                            <field name="satuan"/>
                            <field name="durasi"/>
                        </group>
                    </group>
                    <group>
                        <group string="Periode Pelaksanaan">
                            <field name="tanggal_mulai"/>
                            <field name="tanggal_selesai"/>
                            <field name="otorisasi_luar_periode"
                                   groups="ksg_engineering.group_kepala_unit,base.group_system"/>
                            <field name="alasan_luar_periode"
                                   invisible="not otorisasi_luar_periode"
                                   groups="ksg_engineering.group_kepala_unit,base.group_system"/>
                        </group>
                        <group string="Progress Target &amp; Realisasi">
                            <field name="mode_distribusi" widget="radio" options="{'horizontal': true}"/>
                            <field name="planned_progress_kumulatif" readonly="1" string="Rencana Kumulatif (%)"/>
                            <field name="actual_progress_kumulatif" readonly="1" string="Realisasi Kumulatif (%)"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Target Mingguan">
                            <div class="alert alert-info mb-2" role="alert">
                                <strong>Mode Otomatis:</strong> Akan otomatis mengisi dan membagi rata bobot sesuai tanggal pelaksanaan.<br/>
                                <strong>Mode Manual:</strong> Anda bisa menambahkan dan mengisi target progress (%) secara spesifik untuk minggu tertentu.
                            </div>
                            <field name="target_ids" nolabel="1"
                                   readonly="mode_distribusi == 'otomatis'">
                                <list editable="bottom">
                                    <field name="periode_minggu_id" string="Periode Minggu"
                                           domain="[('project_id', '=', parent.project_id)]"
                                           options="{'no_create': 1}"/>
                                    <field name="target_progress" sum="Total Rencana (%)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sub-Pekerjaan (WBS Anak)">
                            <div class="text-muted mb-2">
                                Jika pekerjaan ini memiliki rincian tahapan, tambahkan di sini. (Total bobot otomatis menyesuaikan nilai).
                            </div>
                            <field name="child_ids" nolabel="1" context="{'default_project_id': project_id, 'default_parent_id': id}">
                                <list>
                                    <field name="nama_pekerjaan"/>
                                    <field name="nilai_pekerjaan" sum="Total"/>
                                    <field name="bobot" sum="Total (%)"/>
                                    <field name="tanggal_mulai"/>
                                    <field name="tanggal_selesai"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>

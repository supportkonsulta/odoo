<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- BAP/BAST Views (FR-014) -->
    <!-- ============================================================ -->

    <record id="view_bapbast_tree" model="ir.ui.view">
        <field name="name">ksg.engineering.bapbast.list</field>
        <field name="model">ksg.engineering.bapbast</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="periode"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'waiting_approval'"
                       decoration-success="state == 'approved'"/>
                <field name="approver_id"/>
                <field name="tanggal_approve"/>
            </list>
        </field>
    </record>

    <record id="view_bapbast_form" model="ir.ui.view">
        <field name="name">ksg.engineering.bapbast.form</field>
        <field name="model">ksg.engineering.bapbast</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ajukan" string="Ajukan"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="ksg_engineering.group_supervisor"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="btn-success"
                            invisible="state != 'waiting_approval'"
                            groups="ksg_engineering.group_kepala_unit"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="periode"/>
                            <field name="progress_ref_id"/>
                        </group>
                        <group>
                            <field name="approver_id"/>
                            <field name="tanggal_approve"/>
                        </group>
                    </group>
                    <group string="Tanda Tangan Digital"
                           invisible="state != 'approved'">
                        <field name="signature_image" widget="image"
                               class="oe_avatar"/>
                    </group>
                    <!-- Signature widget saat approval -->
                    <group string="Tanda Tangan"
                           invisible="state != 'waiting_approval'"
                           groups="ksg_engineering.group_kepala_unit">
                        <field name="signature_image" widget="signature"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>

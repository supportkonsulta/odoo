<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- BAP/BAST Views -->
    <!-- ============================================================ -->

    <record id="view_bapbast_tree" model="ir.ui.view">
        <field name="name">ksg.engineering.bapbast.list</field>
        <field name="model">ksg.engineering.bapbast</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Nomor"/>
                <field name="project_id"/>
                <field name="periode"/>
                <field name="state" string="Status" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'waiting_approval'"
                       decoration-success="state == 'approved'"/>
                <field name="approver_id" string="Disetujui Oleh"/>
                <field name="tanggal_approve" string="Tgl Disetujui"/>
            </list>
        </field>
    </record>

    <record id="view_bapbast_form" model="ir.ui.view">
        <field name="name">ksg.engineering.bapbast.form</field>
        <field name="model">ksg.engineering.bapbast</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ajukan" string="Ajukan ke Kepala Unit"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="ksg_engineering.group_supervisor,base.group_system"/>
                    <button name="action_approve" string="Setujui BAP/BAST"
                            type="object" class="btn-success"
                            invisible="state != 'waiting_approval'"
                            groups="ksg_engineering.group_kepala_unit,base.group_system"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Detail BAP/BAST">
                            <field name="project_id"
                                   readonly="state != 'draft'"/>
                            <field name="periode"
                                   readonly="state != 'draft'"/>
                            <field name="progress_ref_id" string="Referensi Laporan Mingguan"
                                   domain="[('project_id', '=', project_id), ('state', '=', 'done')]"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Informasi Persetujuan">
                            <field name="approver_id" string="Disetujui Oleh"/>
                            <field name="tanggal_approve" string="Tanggal Disetujui"/>
                        </group>
                    </group>
                    <!-- Tanda tangan saat approved -->
                    <group string="Tanda Tangan Digital"
                           invisible="state != 'approved'">
                        <field name="signature_image" widget="image"
                               class="oe_avatar" nolabel="1"/>
                    </group>
                    <!-- Signature input saat menunggu approval -->
                    <group string="Bubuhkan Tanda Tangan"
                           invisible="state != 'waiting_approval'"
                           groups="ksg_engineering.group_kepala_unit,base.group_system">
                        <div class="text-muted mb-2" colspan="2">
                            Tanda tangani di bawah untuk menyetujui BAP/BAST ini.
                        </div>
                        <field name="signature_image" widget="signature" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>

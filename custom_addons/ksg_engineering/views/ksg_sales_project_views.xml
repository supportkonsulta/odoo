<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Inherit Form Project dari ksg_sales — tambah tab Engineering -->
    <!-- External ID view Sales: ksg_sales.view_ksg_sales_project_form -->
    <!-- ============================================================ -->
    <record id="view_ksg_sales_project_engineering_tab" model="ir.ui.view">
        <field name="name">ksg.sales.project.form.engineering.tab</field>
        <field name="model">ksg.sales.project</field>
        <field name="inherit_id" ref="ksg_sales.view_ksg_sales_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Tab Engineering Overview -->
                <page string="Engineering" name="engineering_tab">
                    <group>
                        <group string="Prasyarat Dokumen">
                            <field name="working_permit_ok" widget="boolean_toggle"/>
                            <field name="safety_induction_ok" widget="boolean_toggle"/>
                        </group>
                        <group string="Status Engineering">
                            <field name="bapbast_approved" readonly="1"/>
                            <field name="notify_email_enabled"/>
                        </group>
                    </group>
                    <group string="Kurva-S">
                        <group>
                            <field name="kurva_s_planned"/>
                            <field name="kurva_s_actual"/>
                            <field name="kurva_s_variance"/>
                        </group>
                    </group>
                    <group string="Dokumen Teknis">
                        <field name="document_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </page>

                <!-- Tab WBS -->
                <page string="WBS" name="wbs_tab">
                    <field name="wbs_ids" nolabel="1">
                        <list>
                            <field name="nama_pekerjaan"/>
                            <field name="nilai_pekerjaan"/>
                            <field name="bobot"/>
                            <field name="tanggal_mulai"/>
                            <field name="tanggal_selesai"/>
                            <field name="planned_progress_kumulatif"/>
                            <field name="actual_progress_kumulatif"/>
                        </list>
                    </field>
                </page>

                <!-- Tab Kalender Minggu -->
                <page string="Kalender Minggu" name="schedule_tab">
                    <button name="action_generate_calendar_weeks"
                            string="Generate Kalender Minggu"
                            type="object" class="btn-primary"
                            groups="ksg_engineering.group_engineer,ksg_engineering.group_kepala_unit"/>
                    <field name="schedule_week_ids" nolabel="1">
                        <list>
                            <field name="no_minggu"/>
                            <field name="tanggal_mulai"/>
                            <field name="tanggal_selesai"/>
                        </list>
                    </field>
                </page>

                <!-- Tab Assignment -->
                <page string="Assignment" name="assignment_tab">
                    <field name="assignment_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="user_id"/>
                            <field name="peran"/>
                            <field name="tanggal_mulai_tugas"/>
                            <field name="tanggal_selesai_tugas"/>
                            <field name="active"/>
                        </list>
                    </field>
                </page>

                <!-- Tab BAP/BAST -->
                <page string="BAP/BAST" name="bapbast_tab">
                    <field name="bapbast_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="periode"/>
                            <field name="state"/>
                            <field name="approver_id"/>
                            <field name="tanggal_approve"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

#. module: presenly_saas
#: model:ir.model.fields,field_description:presenly_saas.field_presenly_saas_config__cron_sync_minutes
#: model:ir.model.fields,field_description:presenly_saas.field_res_config_settings__presenly_saas_cron_sync_minutes

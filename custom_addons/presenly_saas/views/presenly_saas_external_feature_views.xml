<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_presenly_saas_external_feature_list" model="ir.ui.view">
        <field name="name">presenly.saas.external.feature.list</field>
        <field name="model">presenly.saas.external.feature</field>
        <field name="arch" type="xml">
            <list string="Fitur Presenly" create="false" edit="false" delete="false">
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'planned'"/>
                <field name="code" string="Fitur"/>
                <field name="description"/>
                <field name="path" optional="show"/>
                <field name="web_page" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="fetched_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_presenly_saas_external_feature_search" model="ir.ui.view">
        <field name="name">presenly.saas.external.feature.search</field>
        <field name="model">presenly.saas.external.feature</field>
        <field name="arch" type="xml">
            <search string="Fitur Presenly">
                <field name="code"/>
                <field name="description"/>
                <filter name="available" string="Tersedia" domain="[('status', '=', 'available')]"/>
                <filter name="planned" string="Direncanakan" domain="[('status', '=', 'planned')]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_presenly_saas_external_feature" model="ir.actions.act_window">
        <field name="name">Fitur Presenly</field>
        <field name="res_model">presenly.saas.external.feature</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Katalog fitur belum ditarik</p>
            <p>
                Katalog ini berisi fitur yang disediakan server Presenly SaaS beserta
                statusnya. Gunakan tombol <b>Segarkan Katalog</b> untuk menariknya.
            </p>
        </field>
    </record>

</odoo>

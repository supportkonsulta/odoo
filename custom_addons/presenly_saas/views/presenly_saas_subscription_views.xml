<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_presenly_saas_subscription_form" model="ir.ui.view">
        <field name="name">presenly.saas.subscription.form</field>
        <field name="model">presenly.saas.subscription</field>
        <field name="arch" type="xml">
            <form string="Presenly SaaS Subscription" create="false" edit="false">
                <header>
                    <button name="action_refresh"
                            type="object"
                            string="Refresh Now"
                            class="btn-primary"
                            groups="presenly_saas.group_presenly_saas_manager"/>
                    <!-- Konfigurasi ada di halaman Settings native; tombol ini
                         hanya mengantar ke sana, bukan membuka form kedua. -->
                    <button name="%(action_presenly_saas_settings)d"
                            type="action"
                            string="Settings"
                            groups="presenly_saas.group_presenly_saas_manager"/>
                    <!-- Server action, bukan method di model ini: penarikan
                         referensi dikerjakan oleh `presenly.saas.config`. -->
                    <button name="%(action_presenly_saas_pull_reference)d"
                            type="action"
                            string="Refresh Reference"
                            groups="presenly_saas.group_presenly_saas_manager"/>
                    <field name="state_source" widget="badge"
                           decoration-success="state_source == 'live'"
                           decoration-warning="state_source == 'cached'"
                           decoration-danger="state_source == 'unreachable'"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="client_name" readonly="1" placeholder="Unknown tenant"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Subscription">
                            <field name="status" widget="badge"
                                   decoration-success="status == 'active'"
                                   decoration-info="status == 'trial'"
                                   decoration-danger="status in ('expired', 'suspended')"
                                   decoration-warning="status == 'unknown'"/>
                            <field name="plan_name"/>
                            <field name="plan_type"/>
                            <field name="is_trial"/>
                            <field name="days_remaining"/>
                        </group>
                        <group string="Tenant">
                            <field name="tenant_code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="price_per_user"/>
                        </group>
                    </group>

                    <group>
                        <group string="Validity Period">
                            <field name="trial_ends_at" invisible="not is_trial"/>
                            <field name="current_period_end"/>
                            <field name="grace_until"/>
                        </group>
                        <group string="Seats">
                            <field name="seats_used"/>
                            <field name="seat_limit"/>
                            <field name="seat_usage_percent" widget="progressbar" nolabel="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Company" name="company">
                            <group>
                                <group string="Contact">
                                    <field name="tenant_email" widget="email"/>
                                    <field name="tenant_whatsapp"/>
                                </group>
                                <group string="Profile">
                                    <field name="tenant_business_sector"/>
                                    <field name="tenant_reference"/>
                                    <field name="tenant_employee_count"/>
                                    <field name="tenant_joined_at"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                This data is copied from the company profile on the Presenly SaaS side and
                                can only be changed there. The
                                <strong>Employee Count</strong> is the figure the client declares,
                                unlike <strong>Seats Used</strong>, which is counted from
                                active accounts.
                            </div>
                        </page>

                        <page string="Plan &amp; Features" name="features">
                            <group>
                                <group string="Plan">
                                    <field name="plan_registered"/>
                                    <field name="feature_count"/>
                                    <field name="included_feature_count"/>
                                </group>
                                <group string="Features Not Included"
                                       invisible="not missing_feature_codes">
                                    <field name="missing_feature_codes" colspan="2" nolabel="1"/>
                                </group>
                            </group>
                            <separator string="Feature Details"/>
                            <field name="features_summary" nolabel="1" readonly="1"/>
                            <div class="text-muted" invisible="plan_registered">
                                This plan is not registered in the SaaS-side plan catalog yet, so every
                                feature is shown as included. Its name and limits
                                need to be reviewed there.
                            </div>
                        </page>

                        <page string="Sync" name="sync">
                            <group>
                                <group string="Last">
                                    <field name="last_sync_at"/>
                                    <field name="server_time"/>
                                </group>
                                <group string="Technical">
                                    <field name="schema_version"/>
                                    <field name="config_id"/>
                                </group>
                            </group>
                            <div class="text-muted" invisible="state_source == 'live'">
                                This snapshot has not been confirmed recently. The status shown is the last
                                answer actually sent by the SaaS server, and is never lowered to
                                expired by a failed refresh.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

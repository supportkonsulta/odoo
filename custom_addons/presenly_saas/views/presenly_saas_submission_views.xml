<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pengajuan: lima jenis, satu pola tampilan. Semua hanya baca: keputusan
         tetap di Presenly, Odoo tidak menyetujui atau menolak. -->

    <record id="view_presenly_saas_leave_list" model="ir.ui.view">
        <field name="name">presenly.saas.leave.list</field>
        <field name="model">presenly.saas.leave</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="leave_date desc">
                <field name="reference_number"/>
                <field name="employee_name"/>
                <field name="leave_type_name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_days" sum="Total days"/>
                <field name="location_name" optional="hide"/>
                <field name="status" widget="badge" decoration-success="status == 'approved'"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status == 'rejected'"/>
                <field name="approver_name" optional="hide"/>
                <field name="approval_waiting_for" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_presenly_saas_leave_search" model="ir.ui.view">
        <field name="name">presenly.saas.leave.search</field>
        <field name="model">presenly.saas.leave</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference_number"/>
                <field name="employee_name"/>
                <field name="employee_nopeg"/>
                <field name="leave_type_name"/>
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('status', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('status', '=', 'rejected')]"/>
                <separator/>
                <filter name="this_month" string="This Month"
                        domain="[('leave_date', '&gt;=', (context_today()).replace(day=1).strftime('%Y-%m-%d'))]"/>
                <filter name="this_year" string="This Year"
                        domain="[('leave_date', '&gt;=', (context_today()).replace(month=1, day=1).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_name'}"/>
                    <filter name="group_type" string="Leave Type"
                            context="{'group_by': 'leave_type_name'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_flow_status" string="Approval Flow"
                            context="{'group_by': 'approval_flow_status'}"/>
                    <filter name="group_approval_level" string="Awaiting Level"
                            context="{'group_by': 'approval_current_level'}"/>
                    <filter name="group_month"
                            context="{'group_by': 'leave_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_presenly_saas_leave_form" model="ir.ui.view">
        <field name="name">presenly.saas.leave.form</field>
        <field name="model">presenly.saas.leave</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="reference_number"/>
                            <field name="employee_name"/>
                            <field name="employee_nopeg"/>
                            <field name="leave_type_name"/>
                            <field name="location_name"/>
                        </group>
                        <group>
                            <field name="status" widget="badge"/>
                            <field name="leave_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="total_days"/>
                            <field name="approver_name"/>
                            <field name="approved_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="purpose"/>
                        <field name="leave_address"/>
                    </group>
                    <!-- Alur persetujuan berjenjang dari Presenly. Kalau jenis
                         pengajuan ini belum punya alur, bloknya disembunyikan:
                         yang kosong tidak perlu terlihat seperti yang rusak. -->
                    <group string="Approval" colspan="2" invisible="not approval_has_workflow">
                        <field name="approval_has_workflow" invisible="1"/>
                        <group>
                            <field name="approval_flow_status" widget="badge"
                                   decoration-success="approval_flow_status == 'approved'"
                                   decoration-warning="approval_flow_status == 'pending'"
                                   decoration-danger="approval_flow_status == 'rejected'"/>
                            <field name="approval_current_level"/>
                            <field name="approval_total_levels"/>
                            <field name="approval_waiting_for"/>
                        </group>
                    </group>
                    <field name="approval_step_ids" colspan="2"
                           invisible="not approval_has_workflow">
                        <list create="false" edit="false" delete="false" default_order="level">
                            <field name="level"/>
                            <field name="step_status" widget="badge"
                                   decoration-success="step_status == 'approved'"
                                   decoration-warning="step_status == 'pending'"
                                   decoration-danger="step_status == 'rejected'"/>
                            <field name="approver_label"/>
                            <field name="acted_by_name"/>
                            <field name="acted_at"/>
                            <field name="rejection_reason" optional="hide"/>
                            <field name="acted_by_nopeg" optional="hide"/>
                            <field name="approver_value" optional="hide"/>
                        </list>
                    </field>
                    <group string="Data Source" colspan="2">
                        <field name="status_raw"/>
                        <field name="fetched_at"/>
                        <field name="source_updated_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_presenly_saas_leave" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>

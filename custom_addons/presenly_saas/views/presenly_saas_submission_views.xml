                            <field name="employee_nopeg"/>
                            <field name="location_name"/>
                        </group>
                        <group>
                            <field name="status" widget="badge" decoration-success="status == 'approved'"
                                   decoration-warning="status == 'pending'"
                                   decoration-danger="status == 'rejected'"/>
                            <field name="certificate_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                    <!-- Persetujuan. Bagian ini SELALU tampil, termasuk saat jenis
                         pengajuan ini belum punya alur berjenjang.

                         Presenly punya dua sumber keputusan dan keduanya
                         ditampilkan di sini: alur berjenjang (satu baris per level),
                         dan kolom keputusan pada pengajuannya sendiri. Sebelumnya
                         seluruh bagian ini disembunyikan saat alurnya kosong,
                         sehingga tenant yang belum menyiapkan alur tidak melihat
                         siapa yang memutuskan — padahal datanya ada.

                         Satu grup datar, bukan dua kolom bersarang: jumlah kolom
                         alur berubah-ubah mengikuti ada atau tidaknya alur, dan
                         kolom bersarang akan menyisakan sel kosong di separuh
                         baris. -->
                    <!-- Persetujuan: hanya rangkaian langkahnya.

                         Ringkasan alur dan kolom keputusan pada pengajuannya sendiri
                         tidak ditampilkan di form — datanya tetap ada di model untuk
                         daftar, pivot, dan ekspor. Kalau jenis pengajuannya tidak
                         punya alur, seluruh bagiannya disembunyikan: judul kosong
                         lebih membingungkan daripada tidak ada judul. -->
                    <group string="Approval" colspan="2" invisible="not approval_has_workflow">
                        <field name="approval_has_workflow" invisible="1"/>
                        <field name="approval_step_ids"
                               widget="presenly_approval_steps"
                               nolabel="1" colspan="2">
                            <list create="false" edit="false" delete="false" default_order="level">
                                <field name="level"/>
                                <field name="step_status" widget="badge"
                                       decoration-success="step_status == 'approved'"
                                       decoration-warning="step_status == 'pending'"
                                       decoration-danger="step_status == 'rejected'"/>
                                <field name="approver_label"/>
                                <field name="acted_by_name"/>
                                <field name="acted_at"/>
                                <field name="rejection_reason" optional="hide"/>
                                <field name="acted_by_nopeg" optional="hide"/>
                                <field name="approver_value" optional="hide"/>
                            </list>
                        </field>
                    </group>

                    <group string="Data Source" colspan="2">
                        <field name="status_raw"/>
                        <field name="fetched_at"/>
                        <field name="source_updated_at"/>
                    </group>
</sheet>
                <!-- Panel pratinjau lampiran, diletakkan SETELAH `</sheet>` seperti
                     form Odoo sendiri: compiler mengganti div ini dengan komponen
                     penampilnya, dan tata letak form menempatkannya di sisi kanan.
                     Kalau ditaruh sebelum sheet, penampilnya muncul di belakang
                     kartu informasi. -->
                <div class="o_attachment_preview"/>
                                    <!-- Chatter dipasang hanya untuk lampirannya: panel pratinjau
                         di sisi kanan digambar oleh chatter, dan panel itu terbuka
                         karena adanya elemen `o_attachment_preview` di atas. Tanpa
                         salah satunya, berkas pengajuannya tidak bisa dilihat. -->
                    <!-- Odoo 19 menggambar chatter dari elemen <chatter/>, bukan
                         dari `div.oe_chatter`: form compiler memilih node dengan tag
                         itu. Chatter-nya dipakai untuk lampirannya — panel pratinjau
                         di sisi kanan digambar chatter, dan terbuka karena adanya
                         `div.o_attachment_preview` di atas. -->
                    <!-- `open_attachments` membuat kotak berkasnya langsung
                         terbuka; tanpa itu pengguna menekan paperclip dulu. -->
                    <chatter open_attachments="True" reload_on_attachment="True"/>

            </form>
        </field>
    </record>


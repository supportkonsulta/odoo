<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Read access is granted to every internal user through the ACL file, so
         the backend banner works without assigning a group by hand. Only the
         configuration itself needs a named group: it holds the API key. -->

    <record id="res_groups_privilege_presenly_saas" model="res.groups.privilege">
        <field name="name">Presenly SaaS</field>
        <field name="sequence">95</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_presenly_saas_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_presenly_saas"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure the Presenly SaaS connection and read the API key.</field>
    </record>

    <!-- Multi-company record rules  -->

    <record id="rule_presenly_saas_config_company" model="ir.rule">
        <field name="name">Presenly SaaS connection: multi-company</field>
        <field name="model_id" ref="model_presenly_saas_config"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_presenly_saas_subscription_company" model="ir.rule">
        <field name="name">Presenly SaaS subscription: multi-company</field>
        <field name="model_id" ref="model_presenly_saas_subscription"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_presenly_saas_sync_log_company" model="ir.rule">
        <field name="name">Presenly SaaS sync log: multi-company</field>
        <field name="model_id" ref="model_presenly_saas_sync_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited Form View - Add Payroll Tab to Employee -->
    <record id="view_employee_form_payroll_inherited" model="ir.ui.view">
        <field name="name">hr.employee.form.payroll.inherited</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Custom Payroll" name="custom_payroll_slips" groups="hr_payroll_custom.group_payroll_user">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_slips" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Payslips</span>
                                <span class="o_stat_value"><field name="slip_count"/></span>
                            </div>
                        </button>
                    </div>
                    <field name="slip_ids" readonly="1"/>
                </page>
                <page string="Contract Versions" name="contract_versions" groups="hr_payroll_custom.group_payroll_manager">
                    <field name="version_ids"
                           context="{'default_employee_id': id, 'default_date_version': context_today().strftime('%Y-%m-%d')}"
                           domain="[('work_location_id', '!=', False)]"
                           groups="hr_payroll_custom.group_payroll_manager">
                        <list editable="bottom">
                            <field name="date_version" required="1"/>
                            <field name="work_location_id" required="1" domain="[('company_id', 'in', parent.presenly_client_ids)]"/>
                            <field name="wage" required="1" widget="monetary"/>
                            <field name="contract_date_start"/>
                            <field name="contract_date_end"/>
                            <field name="active" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_payroll_user" model="res.groups">
        <field name="name">Payroll User</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_payroll_manager" model="res.groups">
        <field name="name">Payroll Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
        <field name="implied_ids" eval="[(4, ref('group_payroll_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company rule for custom.payroll.batch -->
    <record id="rule_payroll_batch_multi_company" model="ir.rule">
        <field name="name">Payroll Batch Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_user'))]"/>
    </record>

    <!-- Multi-company rule for custom.payroll.slip -->
    <record id="rule_payroll_slip_multi_company" model="ir.rule">
        <field name="name">Payroll Slip Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_slip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_user'))]"/>
    </record>

    <!-- Multi-company rule for custom.payroll.tunjangan -->
    <record id="rule_payroll_tunjangan_multi_company" model="ir.rule">
        <field name="name">Payroll Tunjangan Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_tunjangan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_user'))]"/>
    </record>

    <!-- Multi-company rule for custom.payroll.bpjs -->
    <record id="rule_payroll_bpjs_multi_company" model="ir.rule">
        <field name="name">Payroll BPJS Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_bpjs"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_user'))]"/>
    </record>

    <!-- Multi-company rule for custom.payroll.potongan.tetap -->
    <record id="rule_payroll_potongan_tetap_multi_company" model="ir.rule">
        <field name="name">Payroll Potongan Tetap Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_potongan_tetap"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_user'))]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_bill_generate_wizard_form" model="ir.ui.view">
        <field name="name">education.bill.generate.wizard.form</field>
        <field name="model">education.bill.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Tagihan Massal (SPP / UKT)">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Petunjuk:</strong> Form ini akan men-generate tagihan secara otomatis untuk seluruh siswa/mahasiswa aktif di sekolah/kampus yang dipilih sesuai tarif yang berlaku. Tagihan duplikat pada periode yang sama akan otomatis dilewati.
                    </div>
                    <group>
                        <group string="Target Institusi &amp; Kelas">
                            <field name="school_id" options="{'no_create': True}"/>
                            <field name="level" invisible="1"/>
                            <field name="class_id" options="{'no_create': True}"/>
                            <field name="bill_type" readonly="1"/>
                        </group>
                        <group string="Periode &amp; Tanggal">
                            <field name="month" invisible="bill_type != 'spp'" required="bill_type == 'spp'"/>
                            <field name="year" invisible="bill_type != 'spp'" required="bill_type == 'spp'"/>
                            <field name="semester" invisible="bill_type != 'ukt'" required="bill_type == 'ukt'"/>
                            <field name="academic_year_id" options="{'no_create': True}" required="1"/>
                            <field name="bill_date"/>
                            <field name="due_date"/>
                            <field name="auto_publish"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_bills" string="Generate Tagihan" type="object" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_education_bill_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Tagihan Massal</field>
        <field name="res_model">education.bill.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

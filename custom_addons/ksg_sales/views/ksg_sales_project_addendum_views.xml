<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- LIST VIEW -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_project_addendum_list" model="ir.ui.view">
        <field name="name">ksg.sales.project.addendum.list</field>
        <field name="model">ksg.sales.project.addendum</field>
        <field name="arch" type="xml">

            <list string="Addendum Kontrak">

                <field
                    name="project_id"
                    string="Proyek"
                />

                <field
                    name="nilai_awal"
                    string="Nilai Awal"
                />

                <field
                    name="nilai_kontrak_baru"
                    string="Nilai Kontrak Baru"
                />

                <field
                    name="tanggal_perubahan"
                    string="Tanggal Perubahan"
                />

                <field
                    name="kategori_alasan"
                    string="Alasan"
                />

                <field
                    name="state"
                    string="Status"
                    widget="badge"
                    decoration-success="state == 'approved'"
                    decoration-warning="state == 'waiting_approval'"
                    decoration-danger="state == 'rejected'"
                    decoration-muted="state == 'draft'"
                />

            </list>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- FORM VIEW -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_project_addendum_form" model="ir.ui.view">
        <field name="name">ksg.sales.project.addendum.form</field>
        <field name="model">ksg.sales.project.addendum</field>
        <field name="arch" type="xml">

            <form string="Addendum Kontrak">

                <!-- ==================================================
                     HEADER / WORKFLOW
                ================================================== -->

                <header>

                    <!-- AJUKAN APPROVAL -->

                    <button
                        name="action_submit_approval"
                        string="Ajukan Approval"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        groups="ksg_sales.group_sales_user"
                    />


                    <!-- APPROVE -->

                    <button
                        name="action_approve"
                        string="Setujui"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'waiting_approval'"
                        groups="ksg_sales.group_sales_manager"
                    />


                    <!-- REJECT -->

                    <button
                        name="action_reject"
                        string="Tolak"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'waiting_approval'"
                        groups="ksg_sales.group_sales_manager"
                    />


                    <!-- STATUS -->

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,waiting_approval,approved,rejected"
                    />

                </header>


                <sheet>

                    <!-- ==================================================
                         JUDUL
                    ================================================== -->

                    <div class="oe_title">

                        <h1>
                            <span>Addendum Kontrak</span>
                        </h1>

                    </div>


                    <!-- ==================================================
                         INFORMASI PROYEK
                    ================================================== -->

                    <group>

                        <group string="Informasi Proyek">

                            <field
                                name="project_id"
                                string="Proyek"
                                readonly="state != 'draft'"
                            />

                            <field
                                name="tanggal_perubahan"
                                string="Tanggal Perubahan"
                                readonly="state != 'draft'"
                            />

                            <field
                                name="kategori_alasan"
                                string="Kategori Alasan"
                                readonly="state != 'draft'"
                            />

                        </group>


                        <!-- ==================================================
                             NILAI KONTRAK
                        ================================================== -->

                        <group string="Nilai Kontrak">

                            <field
                                name="currency_id"
                                invisible="1"
                            />

                            <field
                                name="nilai_awal"
                                string="Nilai Awal"
                                readonly="1"
                            />

                            <field
                                name="nilai_kontrak_baru"
                                string="Nilai Kontrak Baru"
                                readonly="state != 'draft'"
                            />

                        </group>

                    </group>


                    <!-- ==================================================
                         CATATAN
                    ================================================== -->

                    <group string="Catatan">

                        <field
                            name="catatan"
                            readonly="state != 'draft'"
                            placeholder="Tambahkan alasan atau keterangan perubahan kontrak..."
                        />

                    </group>


                </sheet>


                <!-- ======================================================
                     CHATTER
                ====================================================== -->

                <chatter/>

            </form>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- ACTION -->
    <!-- ====================================================== -->

    <record
        id="action_ksg_sales_project_addendum"
        model="ir.actions.act_window"
    >

        <field name="name">Addendum Kontrak</field>
        <field name="res_model">ksg.sales.project.addendum</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- ====================================================== -->
    <!-- MENU -->
    <!-- ====================================================== -->

    <menuitem
        id="menu_ksg_sales_addendum"
        name="Addendum Kontrak"
        parent="menu_ksg_sales_root"
        action="action_ksg_sales_project_addendum"
        sequence="15"
    />

</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- RAB LIST -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_rab_list" model="ir.ui.view">
        <field name="name">ksg.sales.rab.list</field>
        <field name="model">ksg.sales.rab</field>
        <field name="arch" type="xml">

            <list string="RAB">

                <field
                    name="name"
                    string="Nomor RAB"
                />

                <field
                    name="project_id"
                    string="Proyek"
                />

                <field
                    name="tanggal_rab"
                    string="Tanggal RAB"
                />

                <field
                    name="total_rab"
                    string="Total RAB"
                />

                <field
                    name="state"
                    string="Status"
                    widget="badge"
                    decoration-success="state == 'approved'"
                    decoration-warning="state == 'submitted'"
                    decoration-muted="state == 'draft'"
                />

            </list>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- RAB FORM -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_rab_form" model="ir.ui.view">
        <field name="name">ksg.sales.rab.form</field>
        <field name="model">ksg.sales.rab</field>
        <field name="arch" type="xml">

            <form string="RAB">

                <!-- ==================================================
                     HEADER / WORKFLOW
                ================================================== -->

                <header>

                    <!-- AJUKAN RAB -->

                    <button
                        name="action_submit"
                        string="Ajukan"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />


                    <!-- APPROVE RAB -->

                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        groups="ksg_sales.group_sales_manager"
                        invisible="state != 'submitted'"
                    />


                    <!-- BUAT HPP DARI RAB -->

                    <button
                        name="action_create_hpp"
                        string="Buat HPP"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'approved'"
                    />


                    <!-- STATUS -->

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,approved"
                    />

                </header>


                <sheet>

                    <!-- ==================================================
                         JUDUL RAB
                    ================================================== -->

                    <div class="oe_title">

                        <label
                            for="name"
                            string="Nomor RAB"
                        />

                        <h1>

                            <field
                                name="name"
                                readonly="1"
                            />

                        </h1>

                    </div>


                    <!-- ==================================================
                         INFORMASI RAB
                    ================================================== -->

                    <group>

                        <group string="Informasi RAB">

                            <field
                                name="project_id"
                                string="Proyek"
                                readonly="state == 'approved'"
                            />

                            <field
                                name="tanggal_rab"
                                string="Tanggal RAB"
                                readonly="state == 'approved'"
                            />

                        </group>


                        <!-- ==================================================
                             NILAI RAB
                        ================================================== -->

                        <group string="Nilai RAB">

                            <field
                                name="currency_id"
                                string="Mata Uang"
                                readonly="1"
                            />

                            <field
                                name="total_rab"
                                string="Total RAB"
                                readonly="1"
                            />

                        </group>

                    </group>


                    <!-- ==================================================
                         DESKRIPSI
                    ================================================== -->

                    <group string="Deskripsi">

                        <field
                            name="deskripsi"
                            placeholder="Tambahkan deskripsi RAB..."
                            readonly="state == 'approved'"
                        />

                    </group>


                    <!-- ==================================================
                         DETAIL RAB
                    ================================================== -->

                    <notebook>

                        <page string="Detail RAB">

                            <field
                                name="line_ids"
                                readonly="state == 'approved'"
                            >

                                <list editable="bottom">

                                    <field
                                        name="sequence"
                                        widget="handle"
                                        string=""
                                    />

                                    <field
                                        name="kategori"
                                        string="Kategori"
                                    />

                                    <field
                                        name="uraian"
                                        string="Uraian"
                                    />

                                    <field
                                        name="spesifikasi"
                                        string="Spesifikasi"
                                    />

                                    <field
                                        name="satuan"
                                        string="Satuan"
                                    />

                                    <field
                                        name="qty"
                                        string="Qty"
                                    />

                                    <field
                                        name="harga_satuan"
                                        string="Harga Satuan"
                                    />

                                    <field
                                        name="subtotal"
                                        string="Subtotal"
                                        readonly="1"
                                    />

                                    <field
                                        name="keterangan"
                                        string="Keterangan"
                                    />

                                </list>

                            </field>


                            <!-- ==================================================
                                 TOTAL
                            ================================================== -->

                            <group class="oe_subtotal_footer oe_right">

                                <field
                                    name="total_rab"
                                    string="Total RAB"
                                    readonly="1"
                                />

                            </group>

                        </page>

                    </notebook>

                </sheet>


                <!-- ======================================================
                     CHATTER
                ====================================================== -->

                <chatter/>

            </form>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- RAB ACTION -->
    <!-- ====================================================== -->

    <record
        id="action_ksg_sales_rab"
        model="ir.actions.act_window"
    >

        <field name="name">RAB</field>

        <field name="res_model">ksg.sales.rab</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ====================================================== -->
    <!-- RAB MENU -->
    <!-- ====================================================== -->

    <menuitem
        id="menu_ksg_sales_rab"
        name="RAB"
        parent="menu_ksg_sales_root"
        action="action_ksg_sales_rab"
        sequence="30"
    />

</odoo>
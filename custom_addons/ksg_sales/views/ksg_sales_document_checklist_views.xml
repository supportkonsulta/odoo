<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- LIST VIEW -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_document_checklist_list" model="ir.ui.view">
        <field name="name">ksg.sales.document.checklist.list</field>
        <field name="model">ksg.sales.document.checklist</field>
        <field name="arch" type="xml">

            <list string="Checklist Dokumen">

                <field
                    name="name"
                    string="Nama Checklist"
                />

                <field
                    name="active"
                    string="Aktif"
                    widget="boolean_toggle"
                />

            </list>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- FORM VIEW -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_document_checklist_form" model="ir.ui.view">
        <field name="name">ksg.sales.document.checklist.form</field>
        <field name="model">ksg.sales.document.checklist</field>
        <field name="arch" type="xml">

            <form string="Checklist Dokumen">

                <sheet>

                    <!-- ==================================================
                         JUDUL
                    ================================================== -->

                    <div class="oe_title">

                        <label
                            for="name"
                            string="Nama Checklist"
                        />

                        <h1>

                            <field
                                name="name"
                                placeholder="Contoh: Surat Perintah Kerja"
                            />

                        </h1>

                    </div>


                    <!-- ==================================================
                         STATUS
                    ================================================== -->

                    <group string="Status">

                        <field
                            name="active"
                            string="Aktif"
                            widget="boolean_toggle"
                        />

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- ACTION -->
    <!-- ====================================================== -->

    <record
        id="action_ksg_sales_document_checklist"
        model="ir.actions.act_window"
    >

        <field name="name">Checklist Dokumen</field>
        <field name="res_model">ksg.sales.document.checklist</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>
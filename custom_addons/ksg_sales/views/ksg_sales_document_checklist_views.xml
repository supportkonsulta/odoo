<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ksg_sales_document_checklist_list" model="ir.ui.view">
        <field name="name">ksg.sales.document.checklist.list</field>
        <field name="model">ksg.sales.document.checklist</field>
        <field name="arch" type="xml">
            <list string="Checklist Dokumen">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ksg_sales_document_checklist_form" model="ir.ui.view">
        <field name="name">ksg.sales.document.checklist.form</field>
        <field name="model">ksg.sales.document.checklist</field>
        <field name="arch" type="xml">
            <form string="Checklist Dokumen">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ksg_sales_document_checklist" model="ir.actions.act_window">
        <field name="name">Checklist Dokumen</field>
        <field name="res_model">ksg.sales.document.checklist</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- LIST VIEW -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_category_list" model="ir.ui.view">
        <field name="name">ksg.sales.category.list</field>
        <field name="model">ksg.sales.category</field>
        <field name="arch" type="xml">

            <list string="Kategori Pekerjaan">

                <field
                    name="name"
                    string="Nama Kategori"
                />

                <field
                    name="default_checklist_ids"
                    string="Default Checklist Dokumen"
                    widget="many2many_tags"
                />

                <field
                    name="active"
                    string="Aktif"
                    widget="boolean_toggle"
                />

            </list>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- FORM VIEW -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_category_form" model="ir.ui.view">
        <field name="name">ksg.sales.category.form</field>
        <field name="model">ksg.sales.category</field>
        <field name="arch" type="xml">

            <form string="Kategori Pekerjaan">

                <sheet>

                    <!-- ==================================================
                         JUDUL
                    ================================================== -->

                    <div class="oe_title">

                        <label
                            for="name"
                            string="Nama Kategori"
                        />

                        <h1>

                            <field
                                name="name"
                                placeholder="Contoh: Konsultansi, Engineering, IT, dll."
                            />

                        </h1>

                    </div>


                    <!-- ==================================================
                         STATUS
                    ================================================== -->

                    <group>

                        <group string="Informasi Kategori">

                            <field
                                name="active"
                                string="Aktif"
                                widget="boolean_toggle"
                            />

                        </group>

                    </group>


                    <!-- ==================================================
                         DEFAULT CHECKLIST
                    ================================================== -->

                    <group string="Default Checklist Dokumen">

                        <field
                            name="default_checklist_ids"
                            widget="many2many_tags"
                            placeholder="Pilih checklist dokumen default..."
                        />

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- ACTION -->
    <!-- ====================================================== -->

    <record
        id="action_ksg_sales_category"
        model="ir.actions.act_window"
    >

        <field name="name">Kategori Pekerjaan</field>
        <field name="res_model">ksg.sales.category</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>
<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- =========================================================
         LIST VIEW - HPP
         ========================================================= -->

    <record id="view_ksg_sales_hpp_list" model="ir.ui.view">
        <field name="name">ksg.sales.hpp.list</field>
        <field name="model">ksg.sales.hpp</field>

        <field name="arch" type="xml">

            <list
                string="HPP"
                default_order="id desc"
            >

                <field name="name"/>
                <field name="project_id"/>
                <field name="scope"/>
                <field name="tanggal_hpp"/>
                <field name="total_hpp_bulanan"/>
                <field name="total_hpp_tahunan"/>
                <field name="state"/>

            </list>

        </field>
    </record>


    <!-- =========================================================
         FORM VIEW - HPP
         ========================================================= -->

    <record id="view_ksg_sales_hpp_form" model="ir.ui.view">
        <field name="name">ksg.sales.hpp.form</field>
        <field name="model">ksg.sales.hpp</field>

        <field name="arch" type="xml">

            <form string="HPP">

                <!-- =================================================
                     HEADER
                     ================================================= -->

                <header>

                    <button
                        name="action_submit"
                        string="Ajukan"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_approve"
                        string="Setujui"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'submitted'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,approved"
                    />

                </header>


                <sheet>

                    <!-- =================================================
                         TITLE
                         ================================================= -->

                    <div class="oe_title">

                        <label
                            for="name"
                            class="oe_edit_only"
                        />

                        <h1>

                            <field
                                name="name"
                                readonly="1"
                            />

                        </h1>

                    </div>


                    <!-- =================================================
                         INFORMASI HPP
                         ================================================= -->

                    <group string="Informasi HPP">

                        <group>

                            <field
                                name="project_id"
                                options="{'no_create': True}"
                                readonly="state == 'approved'"
                            />

                            <field
                                name="scope"
                                readonly="1"
                            />

                            <field
                                name="tanggal_hpp"
                                readonly="state == 'approved'"
                            />

                        </group>

                        <group>

                            <field
                                name="currency_id"
                                readonly="1"
                            />

                            <field
                                name="deskripsi"
                                readonly="state == 'approved'"
                            />

                        </group>

                    </group>


                    <!-- =================================================
                         INFO SCOPE OPERATIONAL
                         ================================================= -->

                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="scope != 'operational'"
                    >

                        <strong>HPP Operational</strong>

                        <br/>

                        Detail HPP digunakan untuk menghitung komponen
                        biaya tenaga kerja, perlengkapan, chemical,
                        jasa, dan kebutuhan biaya lainnya.

                    </div>


                    <!-- =================================================
                         INFO SCOPE ENGINEERING
                         ================================================= -->

                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="scope != 'engineering'"
                    >

                        <strong>HPP Engineering</strong>

                        <br/>

                        Struktur HPP digunakan untuk mendukung
                        perhitungan biaya pekerjaan Engineering.

                    </div>


                    <!-- =================================================
                         NOTEBOOK
                         ================================================= -->

                    <notebook>


                        <!-- =============================================
                             TAB 1 - DETAIL HPP
                             ============================================= -->

                        <page
                            string="Detail HPP"
                            name="detail_hpp"
                        >

                            <group>

                                <div class="o_form_label">
                                    Detail utama perhitungan HPP
                                </div>

                            </group>


                            <field
                                name="line_ids"
                                readonly="state == 'approved'"
                            >

                                <list
                                    editable="bottom"
                                    default_order="sequence,id"
                                >

                                    <field name="sequence"/>

                                    <field name="bagian"/>

                                    <field name="mk"/>

                                    <field name="tk"/>

                                    <field
                                        name="currency_id"
                                        column_invisible="True"
                                    />

                                    <field name="uang_pokok"/>

                                    <field name="tunj"/>

                                    <field name="thr"/>

                                    <field name="seragam"/>

                                    <field name="ovh"/>

                                    <field name="sistem"/>

                                    <field name="bpjs_tk"/>

                                    <field name="bpjs_kes"/>

                                    <field name="ex_pengeluaran"/>

                                    <field
                                        name="jumlah_bulan"
                                        readonly="1"
                                    />

                                    <field
                                        name="hpp_tahun"
                                        readonly="1"
                                    />

                                    <field name="tagihan_bulan"/>

                                    <field
                                        name="tagihan_tahun"
                                        readonly="1"
                                    />

                                    <field name="keterangan"/>

                                </list>

                            </field>

                        </page>


                        <!-- =============================================
                             TAB 2 - DETAIL SDM
                             ============================================= -->

                        <page
                            string="Detail SDM"
                            name="detail_sdm"
                            invisible="scope != 'operational'"
                        >

                            <group>

                                <div class="o_form_label">
                                    Detail kebutuhan tenaga kerja
                                </div>

                            </group>


                            <field
                                name="tenaga_kerja_ids"
                                readonly="state == 'approved'"
                            >

                                <list
                                    editable="bottom"
                                    default_order="sequence,id"
                                >

                                    <field name="sequence"/>

                                    <field name="tenaga_kerja"/>

                                    <field name="posisi"/>

                                    <field name="jumlah"/>

                                    <field
                                        name="currency_id"
                                        column_invisible="True"
                                    />

                                    <field
                                        name="estimasi_biaya_satuan"
                                    />

                                    <field
                                        name="total_biaya"
                                        readonly="1"
                                    />

                                    <field name="keterangan"/>

                                </list>

                            </field>


                            <group class="mt16">

                                <group>

                                    <field
                                        name="total_tenaga_kerja"
                                        readonly="1"
                                    />

                                </group>

                            </group>

                        </page>


                        <!-- =============================================
                             TAB 3 - PERLENGKAPAN & CHEMICAL
                             ============================================= -->

                        <page
                            string="Perlengkapan &amp; Chemical"
                            name="perlengkapan_chemical"
                            invisible="scope != 'operational'"
                        >

                            <group>

                                <div class="o_form_label">
                                    Detail kebutuhan perlengkapan
                                    dan chemical
                                </div>

                            </group>


                            <field
                                name="perlengkapan_ids"
                                readonly="state == 'approved'"
                            >

                                <list
                                    editable="bottom"
                                    default_order="sequence,id"
                                >

                                    <field name="sequence"/>

                                    <field name="item"/>

                                    <field name="spesifikasi"/>

                                    <field name="satuan"/>

                                    <field name="jumlah"/>

                                    <field
                                        name="currency_id"
                                        column_invisible="True"
                                    />

                                    <field name="harga_satuan"/>

                                    <field
                                        name="subtotal"
                                        readonly="1"
                                    />

                                    <field name="keterangan"/>

                                </list>

                            </field>

                        </page>


                        <!-- =============================================
                             TAB 4 - PENAWARAN / RAB
                             ============================================= -->

                        <page
                            string="Penawaran / RAB"
                            name="penawaran_rab"
                        >

                            <div
                                class="alert alert-secondary"
                                role="alert"
                            >

                                <strong>Penawaran / RAB</strong>

                                <br/>

                                Tab ini digunakan sebagai dasar
                                penyusunan Penawaran / RAB berdasarkan
                                hasil perhitungan HPP.

                                <br/>

                                Struktur detail Penawaran / RAB akan
                                dikembangkan pada tahap berikutnya.

                            </div>

                        </page>


                        <!-- =============================================
                             TAB 5 - ENGINEERING
                             ============================================= -->

                        <page
                            string="Engineering"
                            name="engineering"
                            invisible="scope != 'engineering'"
                        >

                            <group>

                                <div class="o_form_label">
                                    Detail kebutuhan Engineering
                                </div>

                            </group>


                            <field
                                name="engineering_ids"
                                readonly="state == 'approved'"
                            >

                                <list
                                    editable="bottom"
                                    default_order="sequence,id"
                                >

                                    <field name="sequence"/>

                                    <field name="uraian"/>

                                    <field name="spesifikasi"/>

                                    <field name="satuan"/>

                                    <field name="qty"/>

                                    <field
                                        name="currency_id"
                                        column_invisible="True"
                                    />

                                    <field name="harga_satuan"/>

                                    <field
                                        name="subtotal"
                                        readonly="1"
                                    />

                                    <field name="keterangan"/>

                                </list>

                            </field>

                        </page>


                    </notebook>


                    <!-- =================================================
                         TOTAL SUMMARY
                         ================================================= -->

                    <group
                        string="Ringkasan HPP"
                        class="mt16"
                    >

                        <group>

                            <field
                                name="total_tenaga_kerja"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field
                                name="total_hpp_bulanan"
                                readonly="1"
                            />

                            <field
                                name="total_hpp_tahunan"
                                readonly="1"
                            />

                            <field
                                name="total_hpp"
                                readonly="1"
                            />

                        </group>

                    </group>


                    <!-- =================================================
                         CHATTER
                         ================================================= -->

                    <chatter/>

                </sheet>

            </form>

        </field>
    </record>


    <!-- =========================================================
         ACTION
         ========================================================= -->

    <record id="action_ksg_sales_hpp" model="ir.actions.act_window">

        <field name="name">HPP</field>

        <field name="res_model">ksg.sales.hpp</field>

        <field name="view_mode">list,form</field>

        <field
            name="view_id"
            ref="view_ksg_sales_hpp_list"
        />

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Buat HPP pertama
            </p>

            <p>
                Gunakan HPP untuk melakukan perhitungan
                biaya proyek sebelum menghasilkan
                Penawaran / RAB.
            </p>

        </field>

    </record>


    <!-- =========================================================
         MENU
         ========================================================= -->

    <menuitem
        id="menu_ksg_sales_hpp"
        name="HPP"
        parent="ksg_sales.menu_ksg_sales_root"
        action="action_ksg_sales_hpp"
        sequence="30"
    />

</odoo>
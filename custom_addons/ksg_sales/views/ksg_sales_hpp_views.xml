<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- HPP LIST VIEW -->
    <!-- ===================================================== -->

    <record id="view_ksg_sales_hpp_list" model="ir.ui.view">
        <field name="name">ksg.sales.hpp.list</field>
        <field name="model">ksg.sales.hpp</field>
        <field name="arch" type="xml">

            <list string="HPP">

                <field name="name"/>
                <field name="project_id"/>
                <field name="scope"/>
                <field name="tanggal_hpp"/>
                <field name="total_hpp_bulanan"/>
                <field name="total_hpp_tahunan"/>
                <field name="state"/>

            </list>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- HPP FORM VIEW -->
    <!-- ===================================================== -->

    <record id="view_ksg_sales_hpp_form" model="ir.ui.view">
        <field name="name">ksg.sales.hpp.form</field>
        <field name="model">ksg.sales.hpp</field>
        <field name="arch" type="xml">

            <form string="HPP">

                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <header>

                    <button
                        name="action_submit"
                        type="object"
                        string="Ajukan"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="state != 'submitted'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,approved"
                    />

                </header>


                <!-- ================================================= -->
                <!-- MAIN SHEET -->
                <!-- ================================================= -->

                <sheet>

                    <!-- ============================================= -->
                    <!-- JUDUL -->
                    <!-- ============================================= -->

                    <div class="oe_title">

                        <h1>
                            <field
                                name="name"
                                readonly="1"
                            />
                        </h1>

                    </div>


                    <!-- ============================================= -->
                    <!-- INFORMASI HPP -->
                    <!-- ============================================= -->

                    <group string="Informasi HPP">

                        <group>

                            <field name="project_id"/>

                            <field
                                name="scope"
                                widget="radio"
                                options="{'horizontal': true}"
                                readonly="1"
                            />

                            <field name="tanggal_hpp"/>

                        </group>

                        <group>

                            <field
                                name="currency_id"
                                invisible="1"
                            />

                            <field name="deskripsi"/>

                        </group>

                    </group>


                    <!-- ============================================= -->
                    <!-- INFORMASI -->
                    <!-- ============================================= -->

                    <div
                        class="alert alert-info"
                        role="alert"
                    >

                        <strong>Informasi:</strong>

                        Detail HPP digunakan sebagai rincian
                        perhitungan modal proyek.

                        Kebutuhan Operational dan Engineering
                        digunakan sesuai scope proyek.

                        HPP menjadi dasar perhitungan sebelum
                        digunakan dalam proses pembuatan RAB.

                    </div>


                    <!-- ============================================= -->
                    <!-- NOTEBOOK -->
                    <!-- ============================================= -->

                    <notebook>


                        <!-- ========================================= -->
                        <!-- TAB 1 : DETAIL HPP -->
                        <!-- ========================================= -->

                        <page
                            string="Detail HPP"
                            name="detail_hpp"
                        >

                            <div
                                class="alert alert-secondary"
                                role="alert"
                            >

                                Detail HPP dapat digunakan untuk
                                proyek Operational maupun Engineering.

                                Nilai HPP bulanan dihitung dari
                                komponen biaya pada tabel ini.

                            </div>


                            <field
                                name="line_ids"
                                context="{'default_hpp_id': id}"
                            >

                                <list
                                    editable="bottom"
                                    create="1"
                                    delete="1"
                                >

                                    <field
                                        name="sequence"
                                        widget="handle"
                                    />

                                    <!-- DATA DASAR -->

                                    <field name="bagian"/>

                                    <field name="kategori"/>

                                    <field name="uraian"/>

                                    <field name="spesifikasi"/>

                                    <field name="satuan"/>

                                    <field name="qty"/>

                                    <field name="mk"/>

                                    <field name="tk"/>


                                    <!-- KOMPONEN HPP -->

                                    <field name="uang_pokok"/>

                                    <field name="tunj"/>

                                    <field name="thr"/>

                                    <field name="seragam"/>

                                    <field name="ovh"/>

                                    <field name="sistem"/>

                                    <field name="bpjs_tk"/>

                                    <field name="bpjs_kes"/>

                                    <field name="ex_pengeluaran"/>


                                    <!-- HASIL -->

                                    <field
                                        name="jumlah_bulan"
                                        readonly="1"
                                    />

                                    <field
                                        name="hpp_tahun"
                                        readonly="1"
                                    />

                                    <field name="keterangan"/>

                                </list>

                            </field>


                            <!-- ===================================== -->
                            <!-- TOTAL DETAIL HPP -->
                            <!-- ===================================== -->

                            <group
                                class="mt-3"
                                col="4"
                            >

                                <group>

                                    <field
                                        name="total_hpp_bulanan"
                                        readonly="1"
                                    />

                                </group>

                                <group>

                                    <field
                                        name="total_hpp_tahunan"
                                        readonly="1"
                                    />

                                </group>

                            </group>

                        </page>


                        <!-- ========================================= -->
                        <!-- TAB 2 : KEBUTUHAN OPERATIONAL -->
                        <!-- ========================================= -->

                        <page
                            string="Kebutuhan Operational"
                            name="kebutuhan_operational"
                            invisible="scope != 'operational'"
                        >

                            <div
                                class="alert alert-info"
                                role="alert"
                            >

                                <strong>Kebutuhan Operational</strong>

                                <br/>

                                Data kebutuhan tenaga kerja,
                                perlengkapan dan chemical
                                untuk mendukung perhitungan HPP proyek.

                            </div>


                            <!-- ===================================== -->
                            <!-- TENAGA KERJA -->
                            <!-- ===================================== -->

                            <group string="Kebutuhan Tenaga Kerja">

                                <field
                                    name="tenaga_kerja_ids"
                                    context="{'default_hpp_id': id}"
                                >

                                    <list
                                        editable="bottom"
                                        create="1"
                                        delete="1"
                                    >

                                        <field
                                            name="sequence"
                                            widget="handle"
                                        />

                                        <field
                                            name="posisi"
                                            string="Peran / Posisi"
                                        />

                                        <field
                                            name="jumlah"
                                            string="Jumlah Pekerja"
                                        />

                                        <field
                                            name="estimasi_biaya_satuan"
                                            string="Estimasi Biaya / Orang (Inc. BPJS)"
                                        />

                                        <field
                                            name="total_biaya"
                                            string="Total Biaya"
                                            readonly="1"
                                        />

                                        <field
                                            name="keterangan"
                                            string="Catatan Kebutuhan"
                                        />

                                    </list>

                                </field>

                            </group>


                            <!-- ===================================== -->
                            <!-- PERLENGKAPAN -->
                            <!-- ===================================== -->

                            <group
                                string="Kebutuhan Perlengkapan &amp; Chemical"
                                class="mt-4"
                            >

                                <field
                                    name="perlengkapan_ids"
                                    context="{'default_hpp_id': id}"
                                >

                                    <list
                                        editable="bottom"
                                        create="1"
                                        delete="1"
                                    >

                                        <field
                                            name="sequence"
                                            widget="handle"
                                        />

                                        <field
                                            name="item"
                                            string="Nama Barang / Alat"
                                        />

                                        <field
                                            name="spesifikasi"
                                            string="Spesifikasi"
                                        />

                                        <field
                                            name="satuan"
                                            string="Satuan"
                                        />

                                        <field
                                            name="jumlah"
                                            string="Jumlah"
                                        />

                                        <field
                                            name="keterangan"
                                            string="Keterangan"
                                        />

                                    </list>

                                </field>

                            </group>


                            <!-- ===================================== -->
                            <!-- RINGKASAN OPERATIONAL -->
                            <!-- ===================================== -->

                            <group
                                string="Ringkasan Kebutuhan Operational"
                                class="mt-4"
                                col="4"
                            >

                                <group>

                                    <field
                                        name="total_tenaga_kerja"
                                        readonly="1"
                                    />

                                </group>

                            </group>

                        </page>


                        <!-- ========================================= -->
                        <!-- TAB 3 : KEBUTUHAN ENGINEERING -->
                        <!-- ========================================= -->

                        <page
                            string="Kebutuhan Engineering"
                            name="kebutuhan_engineering"
                            invisible="scope != 'engineering'"
                        >

                            <div
                                class="alert alert-info"
                                role="alert"
                            >

                                <strong>Kebutuhan Engineering</strong>

                                <br/>

                                Bagian ini digunakan untuk mencatat
                                kebutuhan dasar Engineering pada proyek.

                                Struktur ini masih dibuat sederhana
                                dan dapat dikembangkan sesuai kebutuhan
                                Engineering berikutnya.

                            </div>


                            <field
                                name="engineering_ids"
                                context="{'default_hpp_id': id}"
                            >

                                <list
                                    editable="bottom"
                                    create="1"
                                    delete="1"
                                >

                                    <field
                                        name="sequence"
                                        widget="handle"
                                    />

                                    <field name="uraian"/>

                                    <field name="spesifikasi"/>

                                    <field name="satuan"/>

                                    <field name="qty"/>

                                    <field name="harga_satuan"/>

                                    <field
                                        name="subtotal"
                                        readonly="1"
                                    />

                                    <field name="keterangan"/>

                                </list>

                            </field>

                        </page>

                    </notebook>


                    <!-- ============================================= -->
                    <!-- RINGKASAN TOTAL HPP -->
                    <!-- ============================================= -->

                    <group
                        string="Ringkasan HPP"
                        class="mt-4"
                    >

                        <group>

                            <field
                                name="total_hpp_bulanan"
                                readonly="1"
                            />

                            <field
                                name="total_hpp_tahunan"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field
                                name="total_hpp"
                                readonly="1"
                            />

                        </group>

                    </group>

                </sheet>


                <!-- ================================================= -->
                <!-- CHATTER ODOO 19 -->
                <!-- ================================================= -->

                <chatter/>

            </form>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- HPP ACTION -->
    <!-- ===================================================== -->

    <record
        id="action_ksg_sales_hpp"
        model="ir.actions.act_window"
    >

        <field name="name">HPP</field>

        <field name="res_model">ksg.sales.hpp</field>

        <field name="view_mode">list,form</field>

        <field
            name="view_id"
            ref="view_ksg_sales_hpp_list"
        />

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Buat HPP pertama
            </p>

            <p>
                HPP digunakan untuk menghitung
                modal proyek sebelum digunakan
                sebagai dasar pembuatan RAB.
            </p>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- HPP MENU -->
    <!-- ===================================================== -->

    <menuitem
        id="menu_ksg_sales_hpp"
        name="HPP"
        parent="ksg_sales.menu_ksg_sales_root"
        action="action_ksg_sales_hpp"
        sequence="50"
    />

</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- HPP LIST -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_hpp_list" model="ir.ui.view">
        <field name="name">ksg.sales.hpp.list</field>
        <field name="model">ksg.sales.hpp</field>
        <field name="arch" type="xml">

            <list string="HPP">

                <field
                    name="name"
                    string="Nomor HPP"
                />

                <field
                    name="project_id"
                    string="Proyek"
                />

                <field
                    name="rab_id"
                    string="RAB"
                />

                <field
                    name="tanggal_hpp"
                    string="Tanggal HPP"
                />

                <field
                    name="total_hpp"
                    string="Total HPP"
                />

                <field
                    name="state"
                    string="Status"
                    widget="badge"
                    decoration-success="state == 'approved'"
                    decoration-warning="state == 'submitted'"
                    decoration-muted="state == 'draft'"
                />

            </list>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- HPP FORM -->
    <!-- ====================================================== -->

    <record id="view_ksg_sales_hpp_form" model="ir.ui.view">
        <field name="name">ksg.sales.hpp.form</field>
        <field name="model">ksg.sales.hpp</field>
        <field name="arch" type="xml">

            <form string="HPP">

                <!-- ==================================================
                     HEADER / WORKFLOW
                ================================================== -->

                <header>

                    <!-- AJUKAN HPP -->

                    <button
                        name="action_submit"
                        string="Ajukan"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />


                    <!-- APPROVE HPP -->

                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        groups="ksg_sales.group_sales_manager"
                        invisible="state != 'submitted'"
                    />


                    <!-- STATUS -->

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,approved"
                    />

                </header>


                <sheet>

                    <!-- ==================================================
                         JUDUL HPP
                    ================================================== -->

                    <div class="oe_title">

                        <label
                            for="name"
                            string="Nomor HPP"
                        />

                        <h1>

                            <field
                                name="name"
                                readonly="1"
                            />

                        </h1>

                    </div>


                    <!-- ==================================================
                         INFORMASI HPP
                    ================================================== -->

                    <group>

                        <group string="Informasi HPP">

                            <field
                                name="project_id"
                                string="Proyek"
                                readonly="state == 'approved'"
                            />

                            <field
                                name="rab_id"
                                string="RAB"
                                readonly="state == 'approved'"
                            />

                            <field
                                name="tanggal_hpp"
                                string="Tanggal HPP"
                                readonly="state == 'approved'"
                            />

                        </group>


                        <!-- ==================================================
                             NILAI HPP
                        ================================================== -->

                        <group string="Nilai HPP">

                            <field
                                name="currency_id"
                                string="Mata Uang"
                                readonly="1"
                            />

                            <field
                                name="total_hpp"
                                string="Total HPP"
                                readonly="1"
                            />

                        </group>

                    </group>


                    <!-- ==================================================
                         DESKRIPSI
                    ================================================== -->

                    <group string="Deskripsi">

                        <field
                            name="deskripsi"
                            placeholder="Tambahkan deskripsi HPP..."
                            readonly="state == 'approved'"
                        />

                    </group>


                    <!-- ==================================================
                         DETAIL HPP
                    ================================================== -->

                    <notebook>

                        <page string="Detail HPP">

                            <field
                                name="line_ids"
                                readonly="state == 'approved'"
                            >

                                <list editable="bottom">

                                    <field
                                        name="sequence"
                                        widget="handle"
                                        string=""
                                    />

                                    <field
                                        name="kategori"
                                        string="Kategori"
                                    />

                                    <field
                                        name="uraian"
                                        string="Uraian"
                                    />

                                    <field
                                        name="spesifikasi"
                                        string="Spesifikasi"
                                    />

                                    <field
                                        name="satuan"
                                        string="Satuan"
                                    />

                                    <field
                                        name="qty"
                                        string="Qty"
                                    />

                                    <field
                                        name="harga_satuan"
                                        string="Harga Satuan"
                                    />

                                    <field
                                        name="subtotal"
                                        string="Subtotal"
                                        readonly="1"
                                    />

                                    <field
                                        name="keterangan"
                                        string="Keterangan"
                                    />

                                </list>

                            </field>


                            <!-- ==================================================
                                 TOTAL HPP
                            ================================================== -->

                            <group class="oe_subtotal_footer oe_right">

                                <field
                                    name="total_hpp"
                                    string="Total HPP"
                                    readonly="1"
                                />

                            </group>

                        </page>

                    </notebook>

                </sheet>


                <!-- ======================================================
                     CHATTER
                ====================================================== -->

                <chatter/>

            </form>

        </field>
    </record>


    <!-- ====================================================== -->
    <!-- HPP ACTION -->
    <!-- ====================================================== -->

    <record
        id="action_ksg_sales_hpp"
        model="ir.actions.act_window"
    >

        <field name="name">HPP</field>

        <field name="res_model">ksg.sales.hpp</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ====================================================== -->
    <!-- HPP MENU -->
    <!-- ====================================================== -->

    <menuitem
        id="menu_ksg_sales_hpp"
        name="HPP"
        parent="menu_ksg_sales_root"
        action="action_ksg_sales_hpp"
        sequence="40"
    />

</odoo>
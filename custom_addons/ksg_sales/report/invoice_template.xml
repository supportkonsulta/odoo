<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_ksg_invoice">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <div class="page"
                     style="
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 11pt;
                        color: #111111;
                        padding: 25px 38px 10px 38px;
                        line-height: 1.4;
                     ">

                    <!-- =================================================
                         LOGO
                         ================================================= -->
                    <div style="
                        width: 100%;
                        text-align: left;
                        margin-bottom: 8px;
                    ">

                        <t t-set="logo_uri" t-value="o.ksg_logo_data_uri()"/>

                        <img t-if="logo_uri"
                             t-att-src="logo_uri"
                             style="
                                width: 245px;
                                max-height: 85px;
                                object-fit: contain;
                             "/>

                    </div>


                    <!-- =================================================
                         GARIS HEADER
                         ================================================= -->
                    <div style="
                        width: 100%;
                        border-top: 2px solid #000000;
                        margin-top: 2px;
                        margin-bottom: 20px;
                    "></div>


                    <!-- =================================================
                         TITLE
                         ================================================= -->
                    <div style="
                        width: 100%;
                        text-align: center;
                        font-size: 26pt;
                        font-weight: 700;
                        letter-spacing: 1px;
                        margin-bottom: 25px;
                    ">
                        INVOICE
                    </div>


                    <!-- =================================================
                         CUSTOMER + INFO
                         ================================================= -->
                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 25px;
                    ">
                        <tr>

                            <!-- =================================================
                                CUSTOMER
                                ================================================= -->
                            <td style="
                                width: 52%;
                                vertical-align: top;
                                padding-right: 30px;
                            ">

                                <!-- KEPADA YTH. NORMAL -->
                                <div style="
                                    margin-bottom: 3px;
                                    line-height: 1.25;
                                ">
                                    Kepada Yth.
                                </div>

                                <!-- NAMA CUSTOMER OTOMATIS DARI INVOICE -->
                                <div style="
                                    margin-bottom: 1px;
                                    line-height: 1.25;
                                ">
                                    <span t-esc="o.partner_id.name or '-'"/>
                                </div>

                                <!-- ALAMAT CUSTOMER OTOMATIS -->
                                <div style="
                                    line-height: 1.25;
                                    white-space: pre-line;
                                ">
                                    <span t-esc="o.partner_id.contact_address or '-'"/>
                                </div>

                            </td>


                            <!-- INFO INVOICE -->
                            <td style="
                                width: 48%;
                                vertical-align: top;
                            ">

                                <table style="
                                    width: 100%;
                                    border-collapse: collapse;
                                    font-size: 10.5pt;
                                ">

                                    <tr>
                                        <td style="
                                            width: 42%;
                                            padding: 2px 0;
                                        ">
                                            Tanggal
                                        </td>

                                        <td style="
                                            width: 5%;
                                            padding: 2px 0;
                                            text-align: center;
                                        ">
                                            :
                                        </td>

                                        <td style="
                                            width: 53%;
                                            padding: 2px 0;
                                        ">
                                            <span t-if="o.invoice_date"
                                                  t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td style="padding: 2px 0;">
                                            Nomor
                                        </td>

                                        <td style="
                                            padding: 2px 0;
                                            text-align: center;
                                        ">
                                            :
                                        </td>

                                        <td style="padding: 2px 0;">
                                            <span t-esc="o.name or '-'"/>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td style="padding: 2px 0;">
                                            Surat Perintah Kerja
                                        </td>

                                        <td style="
                                            padding: 2px 0;
                                            text-align: center;
                                        ">
                                            :
                                        </td>

                                        <td style="padding: 2px 0;">
                                            <span t-esc="
                                                o.ksg_project_id.no_pk or '-'
                                            "/>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td style="padding: 2px 0;">
                                            ID Project
                                        </td>

                                        <td style="
                                            padding: 2px 0;
                                            text-align: center;
                                        ">
                                            :
                                        </td>

                                        <td style="padding: 2px 0;">
                                            <span t-esc="
                                                o.ksg_project_id.kode_proyek or '-'
                                            "/>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td style="padding: 2px 0;">
                                            Jatuh Tempo
                                        </td>

                                        <td style="
                                            padding: 2px 0;
                                            text-align: center;
                                        ">
                                            :
                                        </td>

                                        <td style="padding: 2px 0;">
                                            <span t-if="o.invoice_date_due"
                                                  t-esc="o.invoice_date_due.strftime('%d/%m/%Y')"/>
                                        </td>
                                    </tr>

                                </table>

                            </td>

                        </tr>
                    </table>


                    <!-- =================================================
                         TABEL PEKERJAAN
                         TANPA KOLOM NO.
                         ================================================= -->

                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 0;
                    ">

                        <thead>

                            <tr>

                                <th style="
                                    width: 72%;
                                    border-top: 1px solid #000000;
                                    border-bottom: 1px solid #000000;
                                    padding: 8px 6px;
                                    text-align: center;
                                    font-weight: 700;
                                    text-transform: uppercase;
                                ">
                                    PEKERJAAN
                                </th>

                                <th style="
                                    width: 28%;
                                    border-top: 1px solid #000000;
                                    border-bottom: 1px solid #000000;
                                    padding: 8px 6px;
                                    text-align: center;
                                    font-weight: 700;
                                    text-transform: uppercase;
                                ">
                                    JUMLAH
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <!--
                                Prioritas:
                                1. Invoice line
                                2. Deskripsi Termin
                                3. Nama Pekerjaan Project
                            -->

                            <t t-set="invoice_lines"
                               t-value="
                                   o.invoice_line_ids.filtered(
                                       lambda l: not l.display_type
                                   )
                               "/>


                            <t t-if="invoice_lines">

                                <t t-foreach="invoice_lines" t-as="line">

                                    <tr>

                                        <td style="
                                            width: 72%;
                                            border-bottom: 1px solid #000000;
                                            padding: 10px 6px;
                                            text-align: left;
                                            vertical-align: top;
                                        ">
                                            <span t-esc="line.name"/>
                                        </td>


                                        <td style="
                                            width: 28%;
                                            border-bottom: 1px solid #000000;
                                            padding: 10px 6px;
                                            text-align: right;
                                            vertical-align: top;
                                            white-space: nowrap;
                                        ">
                                            <span t-esc="
                                                o.ksg_format_idr(
                                                    line.price_subtotal
                                                )
                                            "/>
                                        </td>

                                    </tr>

                                </t>

                            </t>


                            <!-- FALLBACK -->
                            <t t-else="">

                                <tr>

                                    <td style="
                                        width: 72%;
                                        border-bottom: 1px solid #000000;
                                        padding: 10px 6px;
                                        text-align: left;
                                    ">
                                        <span t-esc="
                                            o.ksg_term_id.deskripsi
                                            or o.ksg_project_id.nama_pekerjaan
                                            or '-'
                                        "/>
                                    </td>


                                    <td style="
                                        width: 28%;
                                        border-bottom: 1px solid #000000;
                                        padding: 10px 6px;
                                        text-align: right;
                                        white-space: nowrap;
                                    ">
                                        <span t-esc="
                                            o.ksg_format_idr(
                                                o.amount_untaxed
                                            )
                                        "/>
                                    </td>

                                </tr>

                            </t>

                        </tbody>

                    </table>


                    <!-- =================================================
                         JUMLAH
                         ================================================= -->

                    <div style="
                        width: 100%;
                        margin-top: 16px;
                        text-align: right;
                    ">

                        <table style="
                            width: 42%;
                            margin-left: auto;
                            border-collapse: collapse;
                        ">

                            <tr>

                                <td style="
                                    width: 45%;
                                    padding: 4px 0;
                                    text-align: left;
                                ">
                                    JUMLAH
                                </td>

                                <td style="
                                    width: 55%;
                                    padding: 4px 0;
                                    text-align: right;
                                    white-space: nowrap;
                                ">
                                    <span t-esc="
                                        o.ksg_format_idr(
                                            o.amount_untaxed
                                        )
                                    "/>
                                </td>

                            </tr>


                            <tr>

                                <td style="
                                    padding: 4px 0;
                                    text-align: left;
                                ">
                                    PPN
                                </td>

                                <td style="
                                    padding: 4px 0;
                                    text-align: right;
                                    white-space: nowrap;
                                ">
                                    <span t-esc="
                                        o.ksg_format_idr(
                                            o.amount_tax
                                        )
                                    "/>
                                </td>

                            </tr>

                        </table>

                    </div>


                    <!-- =================================================
                         TOTAL
                         ================================================= -->

                    <div style="
                        width: 100%;
                        margin-top: 4px;
                        margin-bottom: 24px;
                    ">

                        <div style="
                            width: 100%;
                            border-top: 1.5px solid #000000;
                            margin-bottom: 7px;
                        "></div>


                        <table style="
                            width: 42%;
                            margin-left: auto;
                            border-collapse: collapse;
                        ">

                            <tr>

                                <td style="
                                    width: 45%;
                                    padding: 4px 0;
                                    text-align: left;
                                    font-weight: 700;
                                ">
                                    TOTAL
                                </td>


                                <td style="
                                    width: 55%;
                                    padding: 4px 0;
                                    text-align: right;
                                    white-space: nowrap;
                                    font-weight: 700;
                                    font-size: 12pt;
                                ">
                                    <span t-esc="
                                        o.ksg_format_idr(
                                            o.amount_total
                                        )
                                    "/>
                                </td>

                            </tr>

                        </table>

                    </div>


                    <!-- =================================================
                         TERBILANG
                         ================================================= -->

                    <div style="
                        width: 100%;
                        margin-top: 5px;
                        margin-bottom: 32px;
                        text-align: left;
                    ">

                        <div style="
                            margin-bottom: 5px;
                        ">
                            Terbilang :
                        </div>

                        <div style="
                            font-style: italic;
                            line-height: 1.45;
                        ">
                            <span t-esc="o.ksg_terbilang"/>
                        </div>

                    </div>


                    <!-- =================================================
                         TRANSFER KE
                         ================================================= -->

                    <div style="
                        width: 100%;
                        margin-top: 8px;
                        margin-bottom: 30px;
                        text-align: left;
                    ">

                        <div style="
                            margin-bottom: 12px;
                        ">
                            Transfer ke :
                        </div>


                        <t t-set="bank"
                           t-value="o.company_id.bank_ids[:1]"/>


                        <table style="
                            width: 65%;
                            border-collapse: collapse;
                            margin-left: 0;
                        ">

                            <tr>

                                <td style="
                                    width: 30%;
                                    padding: 3px 0;
                                ">
                                    BANK
                                </td>

                                <td style="
                                    width: 5%;
                                    padding: 3px 0;
                                    text-align: center;
                                ">
                                    :
                                </td>

                                <td style="
                                    width: 65%;
                                    padding: 3px 0;
                                ">
                                    <span t-esc="
                                        bank.bank_id.name
                                        if bank and bank.bank_id
                                        else '-'
                                    "/>
                                </td>

                            </tr>


                            <tr>

                                <td style="
                                    padding: 3px 0;
                                ">
                                    NO. REKENING
                                </td>

                                <td style="
                                    padding: 3px 0;
                                    text-align: center;
                                ">
                                    :
                                </td>

                                <td style="
                                    padding: 3px 0;
                                ">
                                    <span t-esc="
                                        bank.acc_number
                                        if bank
                                        else '-'
                                    "/>
                                </td>

                            </tr>


                            <tr>

                                <td style="
                                    padding: 3px 0;
                                ">
                                    NAMA
                                </td>

                                <td style="
                                    padding: 3px 0;
                                    text-align: center;
                                ">
                                    :
                                </td>

                                <td style="
                                    padding: 3px 0;
                                ">
                                    <span t-esc="
                                        bank.partner_id.name
                                        if bank and bank.partner_id
                                        else o.company_id.name
                                    "/>
                                </td>

                            </tr>

                        </table>

                    </div>


                    <!-- =================================================
                         CATATAN
                         ================================================= -->

                    <div style="
                        width: 100%;
                        margin-top: 12px;
                        margin-bottom: 35px;
                        text-align: left;
                    ">

                        <div style="
                            margin-bottom: 8px;
                        ">
                            Catatan :
                        </div>


                        <div style="
                            line-height: 1.6;
                        ">

                            <div>
                                - Invoice ini juga berlaku sebagai kwitansi/tanda penerimaan pembayaran
                            </div>

                            <div>
                                - Pembayaran dianggap lunas apabila dana sudah masuk ke rekening PT Konsulta Semen Gresik
                            </div>

                            <div>
                                - Pembayaran harap mencantumkan nomor invoice
                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         TANDA TANGAN
                         ================================================= -->

                    <div style="
                        width: 100%;
                        margin-top: 10px;
                        margin-bottom: 0;
                        text-align: left;
                    ">

                        <div style="
                            margin-bottom: 5px;
                        ">
                            Hormat kami,
                        </div>


                        <div style="
                            margin-bottom: 55px;
                        ">
                            PT Konsulta Semen Gresik
                        </div>


                        <div style="
                            font-weight: 700;
                            text-decoration: underline;
                            margin-bottom: 3px;
                        ">
                            <span t-esc="
                                o.company_id.ksg_director_name
                                or 'Ir. Irfan Zuchrufudin, S.T., M.M.'
                            "/>
                        </div>


                        <div>
                            Direktur
                        </div>

                    </div>


                    <!-- =================================================
                         FOOTER
                         ================================================= -->

                    <div style="
                        width: 100%;
                        margin-top: 85px;
                        padding-top: 8px;
                        border-top: 1.5px solid #000000;
                        text-align: center;
                        font-size: 8.5pt;
                        line-height: 1.45;
                    ">

                        <div>
                            Kantor : JL Wachid Blok D 1 - 3.
                            Tubanan - Gresik 61122,
                            Telp : 031-3971050, 031-3981732,
                            Ext : 3655
                            Fax : 031-3972883
                        </div>


                        <div style="
                            margin-top: 2px;
                        ">

                            <a href="http://www.konsulta.co.id"
                               style="
                                    color: #0000EE;
                                    text-decoration: underline;
                               ">
                                http://www.konsulta.co.id
                            </a>

                            ,
                            e mail :

                            <a href="mailto:ksg@konsulta.co.id"
                               style="
                                    color: #0000EE;
                                    text-decoration: underline;
                               ">
                                ksg@konsulta.co.id
                            </a>

                        </div>

                    </div>

                </div>

            </t>

        </t>

    </template>

</odoo>